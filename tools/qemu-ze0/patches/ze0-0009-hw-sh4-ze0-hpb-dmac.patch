+/*
+ * ZE0 HPB-DMAC (TODO M8.C1b); see hw/sh4/ze0_hpbdmac.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_SH4_ZE0_HPBDMAC_H
+#define HW_SH4_ZE0_HPBDMAC_H
+
+#include "hw/core/sysbus.h"
+#include "hw/sh4/ze0_sdhi.h"
+#include "qom/object.h"
+
+#define TYPE_ZE0_HPBDMAC "ze0-hpbdmac"
+OBJECT_DECLARE_SIMPLE_TYPE(Ze0HpbDmacState, ZE0_HPBDMAC)
+
+#define ZE0_HPBDMAC_NR_CH   21
+#define ZE0_HPBDMAC_SIZE    0x900
+#define ZE0_HPBDMAC_SD_CH0  8       /* SD host port 0; port 1 = channel 9 */
+
+struct Ze0HpbDmacState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq[2];                /* channels 8 and 9 */
+    bool trace;
+
+    uint32_t regs[ZE0_HPBDMAC_SIZE / 4];
+    Ze0SdhiState *sdhi[2];
+    hwaddr sdhi_buf[2];             /* area-7 address of each SD_BUF0 */
+    uint64_t bytes[2];              /* moved since reset, per SD port */
+    uint32_t transfers[2];
+};
+
+void ze0_hpbdmac_attach_sdhi(Ze0HpbDmacState *s, int port, Ze0SdhiState *h,
+                             hwaddr buf_addr);
+
+#endif
