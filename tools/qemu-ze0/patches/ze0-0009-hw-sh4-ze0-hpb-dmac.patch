diff --git a/hw/sh4/ze0_hpbdmac.c b/hw/sh4/ze0_hpbdmac.c
new file mode 100644
index 000000000..a748e31f0
--- /dev/null
+++ b/hw/sh4/ze0_hpbdmac.c
@@ -0,0 +1,321 @@
+/*
+ * ZE0 HPB-DMAC (TODO M8.C1b): the DMA engine the EU2011 SDHC.dll uses for
+ * every SD data transfer.
+ *
+ * Evidence (EU2011 build B).  SDHC.dll fn 0x039be010 maps physical
+ * 0xffc08000 and builds a pointer table over a 0x40-byte block per
+ * channel (port 0 = channel 8, port 1 = channel 9) plus common registers
+ * at +0x80c/+0x810/+0x814 (EXP-2026-11-20-M8.C1-hpb-dmac).  nk.exe's
+ * interrupt table has one row per channel, INTEVT 0xb60 + 0x20 * ch; the
+ * rows of channels 8 and 9 (INTEVT 0xc60 fn 0x8803e7f8, 0xc80 fn
+ * 0x8803e850) mask INT2 bit 19, clear the channel's bit in +0x814, set
+ * the "DMA done" flag byte of the port (0xa9980a04) and return the SD
+ * SYSINTR (0x1f / 0x20); OEMInterruptDone (fn 0x8803e004) then ORs the
+ * channel bit into +0x810 and +0x814.  So +0x80c is the per-channel
+ * interrupt status, +0x810 its clear register and +0x814 the enable
+ * register.  The layout is that of the Renesas HPB-DMAC (the register
+ * names below are the ones of the public Linux driver rcar-hpbdma.c):
+ *
+ *   channel +0x00 DSAR0  +0x04 DDAR0  +0x08 DTCR0   plane 0
+ *           +0x0c DSAR1  +0x10 DDAR1  +0x14 DTCR1   plane 1
+ *           +0x18 DSASR  +0x1c DDASR  +0x20 DTCSR   current (read-only)
+ *           +0x24 DPTR (request source: 0x0d00 for SD port 0)
+ *           +0x28 DCR    +0x2c DCMDR (bit 0 DMEN)
+ *           +0x30 DSTPR (write 1 = stop)  +0x34 DSTSR (bit 0 = running)
+ *   common  +0x80c DINTSR0  +0x810 DINTCR0  +0x814 DINTMR0
+ *
+ * Model: only the two SD channels move data.  A channel is armed by
+ * DCMDR.DMEN.  When it is armed and the SD host of its port has data
+ * (CC_EXT_MODE.DMASDRW set by the driver), the bytes are copied between
+ * the card and guest RAM at once: DSAR == SD_BUF0 reads the card into
+ * DDAR, DDAR == SD_BUF0 writes DSAR to the card.  DTCR counts transfer
+ * beats: 2 bytes with DCR bit 8, times 8 with DCR bit 21 (burst mode).  When DTCR reaches 0 the channel
+ * stops (DSTSR.0 = 0), DINTSR0 bit ch is set and the interrupt asserts
+ * while DINTMR0 has the bit.  hpbdmac-trace=on logs every register access
+ * and transfer with -d unimp.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include <zlib.h>
+#include "qapi/error.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/sh4/ze0_hpbdmac.h"
+
+#define DSAR0   0x00
+#define DDAR0   0x04
+#define DTCR0   0x08
+#define DSAR1   0x0c
+#define DDAR1   0x10
+#define DTCR1   0x14
+#define DSASR   0x18
+#define DDASR   0x1c
+#define DTCSR   0x20
+#define DPTR    0x24
+#define DCR     0x28
+#define DCMDR   0x2c
+#define DSTPR   0x30
+#define DSTSR   0x34
+
+#define DINTSR0 0x80c
+#define DINTCR0 0x810
+#define DINTMR0 0x814
+
+#define DCMDR_DMEN  0x01
+#define DCR_BTMD    (1u << 21)
+#define DCR_W16     (1u << 8)
+#define A7_MASK     0x1fffffffu
+
+#define CH(s, ch, r) ((s)->regs[((ch) * 0x40 + (r)) / 4])
+#define COMMON(s, r) ((s)->regs[(r) / 4])
+
+static void ze0_hpbdmac_update_irq(Ze0HpbDmacState *s)
+{
+    uint32_t act = COMMON(s, DINTSR0) & COMMON(s, DINTMR0);
+    int p;
+
+    for (p = 0; p < 2; p++) {
+        qemu_set_irq(s->irq[p], (act >> (ZE0_HPBDMAC_SD_CH0 + p)) & 1);
+    }
+}
+
+static unsigned ze0_hpbdmac_unit(Ze0HpbDmacState *s, int ch)
+{
+    /*
+     * Observed DCR / DTCR pairs: SD 64-byte read 0x00202100 / 4, SD
+     * 8-byte read 0x00002100 / 4, serial 0x80-byte buffers 0x00052000 /
+     * 0x80.  So bit 8 selects 16-bit beats (SD_BUF0 is a 16-bit port) and
+     * bit 21 (BTMD, burst mode) makes one count a burst of 8 beats.
+     */
+    uint32_t dcr = CH(s, ch, DCR);
+
+    return ((dcr & DCR_W16) ? 2 : 1) * ((dcr & DCR_BTMD) ? 8 : 1);
+}
+
+/* Move what the SD host has for an armed channel. */
+static void ze0_hpbdmac_run(Ze0HpbDmacState *s, int port)
+{
+    int ch = ZE0_HPBDMAC_SD_CH0 + port;
+    Ze0SdhiState *h = s->sdhi[port];
+    unsigned plane = 0;     /* the SD driver programs plane 0 only */
+    unsigned unit = ze0_hpbdmac_unit(s, ch);
+    uint32_t *sar = &CH(s, ch, plane ? DSAR1 : DSAR0);
+    uint32_t *dar = &CH(s, ch, plane ? DDAR1 : DDAR0);
+    uint32_t *tcr = &CH(s, ch, plane ? DTCR1 : DTCR0);
+    hwaddr buf = s->sdhi_buf[port];
+    uint8_t tmp[512];
+    uint64_t left;
+    uint32_t moved = 0, crc = crc32(0, NULL, 0);
+    uint8_t head[16] = { 0 };
+    bool rd;
+
+    if (!h || !(CH(s, ch, DCMDR) & DCMDR_DMEN) || !ze0_sdhi_dma_mode(h)) {
+        return;
+    }
+    if ((*sar & A7_MASK) == buf) {
+        rd = true;
+    } else if ((*dar & A7_MASK) == buf) {
+        rd = false;
+    } else {
+        qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: ch%d armed with DSAR 0x%08x "
+                      "DDAR 0x%08x, neither is SD_BUF0 of port %d\n",
+                      ch, *sar, *dar, port);
+        return;
+    }
+    left = (uint64_t)*tcr * unit;
+    while (left) {
+        uint32_t want = MIN(left, sizeof(tmp));
+        uint32_t n;
+
+        if (rd) {
+            n = ze0_sdhi_dma_read(h, tmp, want);
+            address_space_write(&address_space_memory, *dar & A7_MASK,
+                                MEMTXATTRS_UNSPECIFIED, tmp, n);
+            *dar += n;
+        } else {
+            want = MIN(want, ze0_sdhi_dma_room(h));
+            address_space_read(&address_space_memory, *sar & A7_MASK,
+                               MEMTXATTRS_UNSPECIFIED, tmp, want);
+            n = ze0_sdhi_dma_write(h, tmp, want);
+            *sar += n;
+        }
+        if (n == 0) {
+            break;
+        }
+        if (moved < sizeof(head)) {
+            memcpy(head + moved, tmp, MIN(n, sizeof(head) - moved));
+        }
+        crc = crc32(crc, tmp, n);
+        left -= n;
+        moved += n;
+    }
+    if (!moved) {
+        return;
+    }
+    *tcr = left / unit;
+    CH(s, ch, DSASR) = *sar;
+    CH(s, ch, DDASR) = *dar;
+    CH(s, ch, DTCSR) = *tcr;
+    s->bytes[port] += moved;
+    if (s->trace) {
+        char hex[2 * sizeof(head) + 1];
+        unsigned i;
+
+        for (i = 0; i < sizeof(head); i++) {
+            snprintf(hex + 2 * i, 3, "%02x", head[i]);
+        }
+        qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: ch%d %s %u bytes, %s 0x%08x, "
+                      "left %u, crc32 0x%08x, head %s\n", ch,
+                      rd ? "read" : "write", moved, rd ? "DDAR" : "DSAR",
+                      (rd ? *dar : *sar) - moved, (unsigned)left, crc, hex);
+    }
+    if (left == 0) {
+        s->transfers[port]++;
+        CH(s, ch, DCMDR) &= ~DCMDR_DMEN;
+        CH(s, ch, DSTSR) &= ~1u;
+        COMMON(s, DINTSR0) |= 1u << ch;
+        ze0_hpbdmac_update_irq(s);
+    }
+}
+
+static void ze0_hpbdmac_kick(void *opaque, int port)
+{
+    ze0_hpbdmac_run(opaque, port);
+}
+
+static uint64_t ze0_hpbdmac_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Ze0HpbDmacState *s = opaque;
+    uint32_t v = s->regs[addr / 4];
+
+    if (addr == DINTCR0) {
+        v = 0;
+    }
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: rd +0x%03x = 0x%08x\n",
+                      (unsigned)addr, v);
+    }
+    return v;
+}
+
+static void ze0_hpbdmac_write(void *opaque, hwaddr addr, uint64_t v,
+                              unsigned size)
+{
+    Ze0HpbDmacState *s = opaque;
+    int ch = addr / 0x40;
+    unsigned r = addr % 0x40;
+
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: wr +0x%03x = 0x%08x\n",
+                      (unsigned)addr, (uint32_t)v);
+    }
+    if (addr == DINTSR0) {
+        return;
+    }
+    if (addr == DINTCR0) {
+        COMMON(s, DINTSR0) &= ~(uint32_t)v;
+        ze0_hpbdmac_update_irq(s);
+        return;
+    }
+    if (addr == DINTMR0) {
+        COMMON(s, DINTMR0) = v;
+        ze0_hpbdmac_update_irq(s);
+        return;
+    }
+    if (ch >= ZE0_HPBDMAC_NR_CH) {
+        s->regs[addr / 4] = v;
+        return;
+    }
+    switch (r) {
+    case DSASR:
+    case DDASR:
+    case DTCSR:
+    case DSTSR:
+        return;
+    case DSTPR:
+        if (v & 1) {
+            CH(s, ch, DCMDR) &= ~DCMDR_DMEN;
+            CH(s, ch, DSTSR) &= ~1u;
+        }
+        return;
+    case DCMDR:
+        CH(s, ch, DCMDR) = v;
+        if (v & DCMDR_DMEN) {
+            CH(s, ch, DSTSR) |= 1;
+            if (ch == ZE0_HPBDMAC_SD_CH0 || ch == ZE0_HPBDMAC_SD_CH0 + 1) {
+                ze0_hpbdmac_run(s, ch - ZE0_HPBDMAC_SD_CH0);
+            }
+        }
+        return;
+    default:
+        s->regs[addr / 4] = v;
+        return;
+    }
+}
+
+static const MemoryRegionOps ze0_hpbdmac_ops = {
+    .read = ze0_hpbdmac_read,
+    .write = ze0_hpbdmac_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+void ze0_hpbdmac_attach_sdhi(Ze0HpbDmacState *s, int port, Ze0SdhiState *h,
+                             hwaddr buf_addr)
+{
+    s->sdhi[port] = h;
+    s->sdhi_buf[port] = buf_addr & A7_MASK;
+    ze0_sdhi_set_dma(h, ze0_hpbdmac_kick, s);
+}
+
+static void ze0_hpbdmac_reset(DeviceState *dev)
+{
+    Ze0HpbDmacState *s = ZE0_HPBDMAC(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->bytes, 0, sizeof(s->bytes));
+    memset(s->transfers, 0, sizeof(s->transfers));
+    ze0_hpbdmac_update_irq(s);
+}
+
+static void ze0_hpbdmac_init(Object *obj)
+{
+    Ze0HpbDmacState *s = ZE0_HPBDMAC(obj);
+
+    memory_region_init_io(&s->iomem, obj, &ze0_hpbdmac_ops, s, "ze0-hpbdmac",
+                          ZE0_HPBDMAC_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[0]);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq[1]);
+}
+
+static const Property ze0_hpbdmac_props[] = {
+    DEFINE_PROP_BOOL("trace", Ze0HpbDmacState, trace, false),
+};
+
+static void ze0_hpbdmac_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    device_class_set_legacy_reset(dc, ze0_hpbdmac_reset);
+    device_class_set_props(dc, ze0_hpbdmac_props);
+}
+
+static const TypeInfo ze0_hpbdmac_types[] = {
+    {
+        .name = TYPE_ZE0_HPBDMAC,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Ze0HpbDmacState),
+        .instance_init = ze0_hpbdmac_init,
+        .class_init = ze0_hpbdmac_class_init,
+    },
+};
+
+DEFINE_TYPES(ze0_hpbdmac_types)
