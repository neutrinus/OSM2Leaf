+/*
+ * M8.H1: move bytes that a host chardev put in the sh_serial FIFO into the
+ * RAM plane the driver armed.  sh_serial exposes the FIFO level at +0x1c;
+ * reading that instead of FSR avoids clearing the transmit flags.  When both
+ * planes are full the channel completes and raises its DMAC interrupt, the
+ * same path M8.C2a uses for transmit completion.
+ */
+static void ze0_hpbdmac_rx_serial(Ze0HpbDmacState *s)
+{
+    int ch;
+    bool again = false;
+
+    for (ch = 0; ch < ZE0_HPBDMAC_NR_CH; ch++) {
+        uint32_t *sar = &CH(s, ch, DSAR0);
+        uint32_t *dar = &CH(s, ch, DDAR0);
+        uint32_t *tcr = &CH(s, ch, DTCR0);
+        uint32_t base, dst, i, n, crc;
+        uint16_t cnt = 0;
+        uint8_t buf[256];
+        char hex[2 * 32 + 1] = "";
+
+        if (!(CH(s, ch, DCMDR) & DCMDR_DMEN) ||
+            !ze0_hpbdmac_is_scif(*sar, SCIF_FRDR) || !*tcr) {
+            continue;
+        }
+        base = *sar & ~0xfffu;
+        dst = *dar & A7_MASK;
+        address_space_read(&address_space_memory, base + SCIF_RX_CNT,
+                           MEMTXATTRS_UNSPECIFIED, &cnt, sizeof(cnt));
+        for (n = 0; n < MIN((uint32_t)cnt, *tcr) && n < sizeof(buf); n++) {
+            address_space_read(&address_space_memory, base + SCIF_FRDR,
+                               MEMTXATTRS_UNSPECIFIED, &buf[n], 1);
+            address_space_write(&address_space_memory, *dar & A7_MASK,
+                                MEMTXATTRS_UNSPECIFIED, &buf[n], 1);
+            (*dar)++;
+            (*tcr)--;
+        }
+        if (!n) {
+            again = true;
+            continue;
+        }
+        crc = crc32(crc32(0, NULL, 0), buf, n);
+        for (i = 0; i < n && i < 32; i++) {
+            snprintf(hex + 2 * i, 3, "%02x", buf[i]);
+        }
+        if (s->trace) {
+            qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: ch%d rx %u bytes, SCIF "
+                          "0x%08x -> 0x%08x, crc32 0x%08x, data %s\n",
+                          ch, n, *sar, dst, crc, hex);
+        }
+        s->rx_bytes[ch] += n;
+        if (*tcr) {
+            again = true;
+            continue;
+        }
+        if (!s->rx_plane[ch] && CH(s, ch, DDAR1)) {
+            /* first 0x80-byte plane full: switch to the second one */
+            s->rx_plane[ch] = true;
+            CH(s, ch, DDAR0) = CH(s, ch, DDAR1);
+            CH(s, ch, DTCR0) = s->rx_tcr[ch];
+            CH(s, ch, DDASR) = *dar;
+            again = true;
+            continue;
+        }
+        CH(s, ch, DSASR) = *sar;
+        CH(s, ch, DDASR) = *dar;
+        CH(s, ch, DTCSR) = 0;
+        s->rx_transfers[ch]++;
+        CH(s, ch, DCMDR) &= ~DCMDR_DMEN;
+        CH(s, ch, DSTSR) &= ~1u;
+        COMMON(s, DINTSR0) |= 1u << ch;
+        ze0_hpbdmac_update_irq(s);
+    }
+
+    if (again) {
+        timer_mod(s->rx_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + RX_POLL_NS);
+    }
+}
+
+static void ze0_hpbdmac_rx_timer(void *opaque)
+{
+    ze0_hpbdmac_rx_serial((Ze0HpbDmacState *)opaque);
+}
