+/*
+ * Nissan Leaf ZE0 (2011-2012) navigation unit - QEMU machine skeleton
+ *
+ * SH-4A (SH7785-class) Windows CE 5.0 head unit.  This is a research
+ * skeleton for full-system emulation of the Clarion QY-7204N navigation
+ * firmware; it is not a hardware model.  See docs/research/full-system-
+ * emulation.md and TODO M8.
+ *
+ * Memory map (physical, observed):
+ *   0x08000000 + 128 MiB  DRAM (kernel image B loads at 0x08000000)
+ *   0x10000000            area 4 (graphics/DSP; catch-all until modelled)
+ *   0x18000000            area 6 external devices (catch-all; 0x19300000
+ *                         is stubbed by ze0-stubs)
+ *   0xf0000000            SH-4 cache/TLB arrays (CCN)
+ *   0xff000000            SH-4 CCN/MMU/exception registers
+ *   0xff800000-0xffffffff on-chip peripherals (catch-all; specific windows
+ *                         stubbed by ze0-stubs and future device models)
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/units.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "cpu.h"
+#include "hw/boards.h"
+#include "hw/loader.h"
+#include "hw/misc/unimp.h"
+#include "hw/qdev-properties.h"
+#include "hw/sh4/sh.h"
+#include "hw/sh4/sh4_ccn.h"
+#include "sysemu/sysemu.h"
+
+#define ZE0_RAM_BASE   0x08000000u
+#define ZE0_RAM_SIZE   (128 * MiB)
+
+#define ZE0_CCN_IO_BASE    0xff000000u
+#define ZE0_CCN_ARRAY_BASE 0xf0000000u
+
+#define ZE0_P4_CATCH_BASE  0xff800000u
+#define ZE0_P4_CATCH_SIZE  0x00800000u  /* to 0xffffffff */
+
+#define ZE0_AREA4_BASE     0x10000000u
+#define ZE0_AREA4_SIZE     0x04000000u
+
+#define ZE0_AREA6_BASE     0x18000000u
+#define ZE0_AREA6_SIZE     0x04000000u
+
+static void ze0_init(MachineState *machine)
+{
+    SuperHCPU *cpu;
+    MemoryRegion *sysmem = get_system_memory();
+    MemoryRegion *ram = g_new(MemoryRegion, 1);
+    MemoryRegion *ram_p1 = g_new(MemoryRegion, 1);
+    MemoryRegion *ram_p2 = g_new(MemoryRegion, 1);
+    SH4CCNState *ccn;
+
+    if (machine->ram_size < ZE0_RAM_SIZE) {
+        error_report("ze0: at least %u MiB RAM required",
+                     (unsigned)(ZE0_RAM_SIZE / MiB));
+        exit(1);
+    }
+
+    cpu = SUPERH_CPU(cpu_create(machine->cpu_type));
+    if (!cpu) {
+        error_report("ze0: failed to create CPU '%s'", machine->cpu_type);
+        exit(1);
+    }
+
+    /* Physical DRAM at 0x08000000. */
+    memory_region_init_ram(ram, NULL, "ze0.ram", ZE0_RAM_SIZE, &error_fatal);
+    memory_region_add_subregion(sysmem, ZE0_RAM_BASE, ram);
+
+    /*
+     * P1 (cached, 0x8.......) and P2 (uncached, 0xa.......) aliases of the
+     * same physical DRAM.  The SH-4 CPU translates P1/P2 accesses directly,
+     * but explicit aliases make -device loader and monitor accesses that use
+     * these addresses work as expected.
+     */
+    memory_region_init_alias(ram_p1, NULL, "ze0.ram-p1", ram, 0, ZE0_RAM_SIZE);
+    memory_region_add_subregion(sysmem, ZE0_RAM_BASE | 0x80000000u, ram_p1);
+    memory_region_init_alias(ram_p2, NULL, "ze0.ram-p2", ram, 0, ZE0_RAM_SIZE);
+    memory_region_add_subregion(sysmem, ZE0_RAM_BASE | 0xa0000000u, ram_p2);
+
+    /*
+     * Unimplemented-device catch-all windows (priority 0).  ze0-stubs maps
+     * its modelled registers at priority 1 and the CCN is mapped explicitly,
+     * so neither is shadowed.
+     */
+    create_unimplemented_device("ze0-p4", ZE0_P4_CATCH_BASE, ZE0_P4_CATCH_SIZE);
+    create_unimplemented_device("ze0-area4", ZE0_AREA4_BASE, ZE0_AREA4_SIZE);
+    create_unimplemented_device("ze0-area6", ZE0_AREA6_BASE, ZE0_AREA6_SIZE);
+
+    /* SH-4 CCN/MMU/exception registers and cache/TLB arrays. */
+    ccn = SH4_CCN(qdev_new(TYPE_SH4_CCN));
+    qdev_realize_and_unref(DEVICE(ccn), NULL, &error_fatal);
+    sh4_ccn_set_cpu(ccn, cpu);
+    memory_region_add_subregion(sysmem, ZE0_CCN_IO_BASE, sh4_ccn_iomem(ccn));
+    memory_region_add_subregion(sysmem, ZE0_CCN_ARRAY_BASE, sh4_ccn_arrays(ccn));
+
+    /* Boot-blocker stubs (M8.A5): priority 1 over the P4/area-6 catch-all. */
+    qdev_realize_and_unref(qdev_new("ze0-stubs"), NULL, &error_fatal);
+}
+
+static void ze0_machine_init(MachineClass *mc)
+{
+    mc->desc = "Nissan Leaf ZE0 navigation unit (SH-4A, research skeleton)";
+    mc->init = ze0_init;
+    mc->default_cpu_type = TYPE_SH7785_CPU;
+    mc->default_ram_size = ZE0_RAM_SIZE;
+    mc->default_ram_id = "ze0.ram";
+}
+
+DEFINE_MACHINE("ze0", ze0_machine_init)
