diff --git a/hw/sh4/ze0_hpbdmac.c b/hw/sh4/ze0_hpbdmac.c
--- a/hw/sh4/ze0_hpbdmac.c
+++ b/hw/sh4/ze0_hpbdmac.c
@@ -24,7 +24,19 @@
  *           +0x30 DSTPR (write 1 = stop)  +0x34 DSTSR (bit 0 = running)
  *   common  +0x80c DINTSR0  +0x810 DINTCR0  +0x814 DINTMR0
  *
- * Model: only the two SD channels move data.  A channel is armed by
+ * Serial channels (M8.C2a).  serial_scif.dll programs channel 10 as
+ * DSAR = RAM 0xa999a000, DDAR = SCIF1 FTDR 0xffe4100c, DCR 0x20, DPTR 1,
+ * and channels 1/3/7 as DSAR = SCIF1/3/7 FRDR (0xffe4n014), DDAR = two
+ * 0x80-byte RAM buffers (planes 0/1), DCR 0x00052000.  Their interrupt
+ * rows (INTEVT 0xb60 + 0x20 * ch, e.g. 0xca0 fn 0x8803e8a8, 0xb80
+ * fn 0x8803e654) mask INT2 bit 19, clear the channel's bit in DINTMR0
+ * and return SYSINTR 0x13.  With serial=on (default) an armed channel
+ * whose DDAR is a SCIF FTDR (offset 0x0c in 0x1fe40000-0x1fe47fff) and
+ * whose DSAR is RAM writes its bytes one at a time to that FTDR (the
+ * sh_serial device behind it) and completes like an SD channel.  A
+ * channel whose DSAR is a SCIF FRDR stays armed: no peer sends data.
+ *
+ * Model: the two SD channels move SD data.  A channel is armed by
  * DCMDR.DMEN.  When it is armed and the SD host of its port has data
  * (CC_EXT_MODE.DMASDRW set by the driver), the bytes are copied between
  * the card and guest RAM at once: DSAR == SD_BUF0 reads the card into
@@ -78,11 +90,77 @@
 static void ze0_hpbdmac_update_irq(Ze0HpbDmacState *s)
 {
     uint32_t act = COMMON(s, DINTSR0) & COMMON(s, DINTMR0);
-    int p;
+    int ch;
+
+    for (ch = 0; ch < ZE0_HPBDMAC_NR_CH; ch++) {
+        qemu_set_irq(s->irq[ch], (act >> ch) & 1);
+    }
+}
+
+#define SCIF_A7_BASE    0x1fe40000u
+#define SCIF_A7_END     0x1fe48000u
+#define SCIF_FTDR       0x0c
+#define SCIF_FRDR       0x14
+
+static bool ze0_hpbdmac_is_scif(uint32_t a, unsigned reg)
+{
+    a &= A7_MASK;
+    return a >= SCIF_A7_BASE && a < SCIF_A7_END && (a & 0xfff) == reg;
+}
+
+/* Serial channels (M8.C2a): memory -> SCIF FTDR, at once. */
+static void ze0_hpbdmac_run_serial(Ze0HpbDmacState *s, int ch)
+{
+    unsigned unit = 1;      /* DCR 0x20: byte beats (bit 8 clear) */
+    uint32_t *sar = &CH(s, ch, DSAR0);
+    uint32_t *dar = &CH(s, ch, DDAR0);
+    uint32_t *tcr = &CH(s, ch, DTCR0);
+    uint32_t n, i, crc;
+    uint8_t buf[256];
+    char hex[2 * 32 + 1] = "";
 
-    for (p = 0; p < 2; p++) {
-        qemu_set_irq(s->irq[p], (act >> (ZE0_HPBDMAC_SD_CH0 + p)) & 1);
+    if (ze0_hpbdmac_is_scif(*sar, SCIF_FRDR)) {
+        if (s->trace) {
+            qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: ch%d rx armed from SCIF "
+                          "0x%08x into 0x%08x/0x%08x, %u bytes per plane "
+                          "(no peer: stays armed)\n", ch, *sar, *dar,
+                          CH(s, ch, DDAR1), *tcr);
+        }
+        return;
     }
+    if (!ze0_hpbdmac_is_scif(*dar, SCIF_FTDR)) {
+        qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: ch%d armed with DSAR 0x%08x "
+                      "DDAR 0x%08x DCR 0x%08x: not modelled\n", ch, *sar,
+                      *dar, CH(s, ch, DCR));
+        return;
+    }
+    n = MIN((uint64_t)*tcr * unit, sizeof(buf));
+    address_space_read(&address_space_memory, *sar & A7_MASK,
+                       MEMTXATTRS_UNSPECIFIED, buf, n);
+    for (i = 0; i < n; i++) {
+        address_space_write(&address_space_memory, *dar & A7_MASK,
+                            MEMTXATTRS_UNSPECIFIED, &buf[i], 1);
+    }
+    crc = crc32(crc32(0, NULL, 0), buf, n);
+    for (i = 0; i < n && i < 32; i++) {
+        snprintf(hex + 2 * i, 3, "%02x", buf[i]);
+    }
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: ch%d tx %u bytes, DSAR 0x%08x "
+                      "-> SCIF 0x%08x, crc32 0x%08x, data %s\n", ch, n, *sar,
+                      *dar, crc, hex);
+    }
+    *sar += n;
+    *tcr = 0;
+    CH(s, ch, DSASR) = *sar;
+    CH(s, ch, DDASR) = *dar;
+    CH(s, ch, DTCSR) = 0;
+    s->tx_bytes[ch] += n;
+    s->tx_transfers[ch]++;
+    CH(s, ch, DCMDR) &= ~DCMDR_DMEN;
+    CH(s, ch, DSTSR) &= ~1u;
+    COMMON(s, DINTSR0) |= 1u << ch;
+    ze0_hpbdmac_update_irq(s);
 }
 
