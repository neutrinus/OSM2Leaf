+/* ------------------------------------------------------------------------
+ * M8.H3: external UARTs UAT3/UAT4 (serial_uat.dll, docs/firmware/serial-uat.md)
+ *
+ * The chip is 16550-like but the driver uses 16-bit READ/WRITE_PORT_USHORT
+ * at a 2-byte stride: the eight classic registers live at base+0,+2,...,+0xe
+ * and two vendor registers at +0x1a/+0x1c.  Bytes written to THR go to the
+ * host chardev; bytes read from that chardev fill a 64-byte RX FIFO and
+ * assert the INTC line (SYSINTR 0x1b measured for UAT3).
+ * ------------------------------------------------------------------------ */
+#define ZE0_UART_BASE3    0x19b00000u
+#define ZE0_UART_BASE4    0x19e00000u
+#define ZE0_UART_SIZE     0x1000u
+#define ZE0_UART_FIFO     64
+
+typedef struct Ze0Uart {
+    MemoryRegion mmio;
+    CharFrontend chr;
+    qemu_irq irq;
+    uint16_t regs[8];
+    uint16_t divisor;
+    bool dlab;
+    uint8_t rx[ZE0_UART_FIFO];
+    unsigned rx_head;
+    unsigned rx_count;
+    bool irq_asserted;
+} Ze0Uart;
+
+static void ze0_uart_update_irq(Ze0Uart *u)
+{
+    bool level = u->rx_count > 0;
+
+    if (level != u->irq_asserted) {
+        u->irq_asserted = level;
+        qemu_set_irq(u->irq, level);
+    }
+}
+
+static int ze0_uart_can_read(void *opaque)
+{
+    Ze0Uart *u = opaque;
+
+    return u->rx_count < ZE0_UART_FIFO ? 64 : 0;
+}
+
+static void ze0_uart_chr_read(void *opaque, const uint8_t *buf, int size)
+{
+    Ze0Uart *u = opaque;
+    int i;
+
+    for (i = 0; i < size && u->rx_count < ZE0_UART_FIFO; i++) {
+        u->rx[(u->rx_head + u->rx_count) % ZE0_UART_FIFO] = buf[i];
+        u->rx_count++;
+    }
+    qemu_log_mask(LOG_UNIMP, "ze0-uart chr read %d bytes, fifo=%u, irq=%d\n",
+                  size, u->rx_count, u->irq_asserted);
+    ze0_uart_update_irq(u);
+}
+
+static void ze0_uart_chr_event(void *opaque, QEMUChrEvent event)
+{
+}
+
+static uint64_t ze0_uart_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Ze0Uart *u = opaque;
+    unsigned idx = (addr & 0xff) >> 1;
+    uint16_t val;
+
+    if (idx >= 8) {
+        return 0;
+    }
+    qemu_log_mask(LOG_UNIMP, "ze0-uart read idx=%u addr=0x%x\n", idx,
+                  (unsigned)(addr & 0xff));
+    if (u->dlab && idx < 2) {
+        return idx ? (u->divisor >> 8) : (u->divisor & 0xff);
+    }
+    switch (idx) {
+    case 0: /* RBR */
+        val = 0;
+        if (u->rx_count) {
+            val = u->rx[u->rx_head];
+            u->rx_head = (u->rx_head + 1) % ZE0_UART_FIFO;
+            u->rx_count--;
+            ze0_uart_update_irq(u);
+        }
+        break;
+    case 2: /* IIR: no interrupt pending encoded (line is separate) */
+        val = 1;
+        break;
+    case 5: /* LSR: data ready in bit 0 */
+        val = u->rx_count ? 1 : 0;
+        break;
+    default:
+        val = u->regs[idx];
+        break;
+    }
+    return val;
+}
+
+static void ze0_uart_write(void *opaque, hwaddr addr, uint64_t val,
+                           unsigned size)
+{
+    Ze0Uart *u = opaque;
+    unsigned idx = (addr & 0xff) >> 1;
+    uint8_t byte = val & 0xff;
+
+    if (idx >= 8) {
+        return;
+    }
+    qemu_log_mask(LOG_UNIMP, "ze0-uart write idx=%u val=0x%x\n", idx,
+                  (unsigned)val);
+    if (u->dlab && idx < 2) {
+        if (idx == 0) {
+            u->divisor = (u->divisor & 0xff00) | byte;
+        } else {
+            u->divisor = (u->divisor & 0x00ff) | ((uint16_t)byte << 8);
+        }
+        return;
+    }
+    switch (idx) {
+    case 0: /* THR */
+        qemu_chr_fe_write(&u->chr, &byte, 1);
+        break;
+    case 2: /* FCR: driver caches and masks the self-clearing bits */
+        u->regs[2] = val & 0xfff9;
+        break;
+    case 3: /* LCR, DLAB = bit 7 */
+        u->dlab = !!(val & 0x80);
+        u->regs[3] = val;
+        break;
+    default:
+        u->regs[idx] = val;
+        break;
+    }
+}
+
+static const MemoryRegionOps ze0_uart_ops = {
+    .read = ze0_uart_read,
+    .write = ze0_uart_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 2, .max_access_size = 2 },
+    .impl = { .min_access_size = 2, .max_access_size = 2 },
+};
+
+static Ze0Uart *ze0_uart_create(Ze0MachineState *zm, const char *id,
+                                hwaddr base, qemu_irq irq, uint16_t intevt)
+{
+    Ze0Uart *u = g_new0(Ze0Uart, 1);
+    Chardev *chr = qemu_chr_find(id);
+
+    if (!chr) {
+        error_report("ze0: uart: no chardev with id '%s'", id);
+        exit(1);
+    }
+    qemu_chr_fe_init(&u->chr, chr, &error_fatal);
+    qemu_chr_fe_set_handlers(&u->chr, ze0_uart_can_read,
+                             ze0_uart_chr_read, ze0_uart_chr_event,
+                             NULL, u, NULL, true);
+    u->irq = irq;
+    memory_region_init_io(&u->mmio, NULL, &ze0_uart_ops, u,
+                          g_strdup_printf("ze0-uart-%s", id), ZE0_UART_SIZE);
+    memory_region_add_subregion_overlap(get_system_memory(), base, &u->mmio, 2);
+    return u;
+}
+
+#define ZE0_UART_PROPS(n)                                                      \
+    static char *ze0_get_uart##n(Object *obj, Error **errp)                    \
+    {                                                                          \
+        return g_strdup(ZE0_MACHINE(obj)->uart_chardev[n] ?: "");              \
+    }                                                                          \
+    static void ze0_set_uart##n(Object *obj, const char *value, Error **errp)  \
+    {                                                                          \
+        char **slot = &ZE0_MACHINE(obj)->uart_chardev[n];                      \
+        g_free(*slot);                                                         \
+        *slot = *value ? g_strdup(value) : NULL;                               \
+    }                                                                          \
+    static char *ze0_get_uart##n##_intevt(Object *obj, Error **errp)           \
+    {                                                                          \
+        return g_strdup_printf("0x%x", ZE0_MACHINE(obj)->uart_intevt[n]);      \
+    }                                                                          \
+    static void ze0_set_uart##n##_intevt(Object *obj, const char *value,       \
+                                         Error **errp)                         \
+    {                                                                          \
+        ZE0_MACHINE(obj)->uart_intevt[n] =                                     \
+            (uint16_t)g_ascii_strtoull(value, NULL, 0);                        \
+    }
+
+ZE0_UART_PROPS(0)
+ZE0_UART_PROPS(1)
