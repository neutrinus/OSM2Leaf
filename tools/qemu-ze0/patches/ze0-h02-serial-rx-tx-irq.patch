+static void sh_serial_to_int(void *opaque)
+{
+    SHSerialState *s = opaque;
+    SCTR(s, "to rx_cnt=%d scr=%02x lsr=%x", s->rx_cnt, s->scr, s->lsr);
+
+    if (s->rx_cnt) {
+        /* the DMA has not drained the FIFO yet: time out after it has */
+        timer_mod(&s->to_timer,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 15 * s->etu);
+        return;
+    }
+    s->lsr |= 4;
+    if (s->scr & (1 << 3) && s->eri) {
+        qemu_set_irq(s->eri, 1);
+    }
+}
