 /* Serial channels (M8.C2a): memory -> SCIF FTDR, at once. */
+/* M8.H46: memory -> SSI PCM FIFO, forwarded to the audio backend. */
+static void ze0_hpbdmac_run_ssi(Ze0HpbDmacState *s, int ch)
+{
+    uint32_t *sar = &CH(s, ch, DSAR0);
+    uint32_t *dar = &CH(s, ch, DDAR0);
+    uint32_t *tcr = &CH(s, ch, DTCR0);
+    uint8_t buf[1024];
+    uint32_t n = MIN(*tcr, sizeof(buf));
+
+    address_space_read(&address_space_memory, *sar & A7_MASK,
+                       MEMTXATTRS_UNSPECIFIED, buf, n);
+    ze0_ssi_play(s->ssi, buf, n);
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-hpbdmac: ch%d audio %u bytes, DSAR "
+                      "0x%08x -> SSI 0x%08x\n", ch, n, *sar, *dar);
+    }
+    *sar += n;
+    *tcr = 0;
+    CH(s, ch, DSASR) = *sar;
+    CH(s, ch, DDASR) = *dar;
+    CH(s, ch, DTCSR) = 0;
+    CH(s, ch, DCMDR) &= ~DCMDR_DMEN;
+    CH(s, ch, DSTSR) &= ~1u;
+    COMMON(s, DINTSR0) |= 1u << ch;
+    ze0_hpbdmac_update_irq(s);
+}
+
+void ze0_hpbdmac_attach_ssi(Ze0HpbDmacState *s, Ze0SsiState *ssi)
+{
+    s->ssi = ssi;
+}
+
+void ze0_hpbdmac_selftest_audio(Ze0HpbDmacState *s, uint32_t sar, uint32_t n)
+{
+    if (!s->ssi) {
+        return;
+    }
+    CH(s, 12, DSAR0) = sar;
+    CH(s, 12, DDAR0) = 0x1fe00174u;
+    CH(s, 12, DTCR0) = n;
+    CH(s, 12, DCMDR) = DCMDR_DMEN;
+    CH(s, 12, DSTSR) = 1;
+    ze0_hpbdmac_run_ssi(s, 12);
+}
