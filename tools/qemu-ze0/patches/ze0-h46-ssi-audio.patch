--- /dev/null
+++ b/hw/sh4/ze0_ssi.c
@@ -0,0 +1,206 @@
+/*
+ * ZE0 SSI: register stub plus a PCM sink for the HPB-DMAC (TODO M8.H46).
+ *
+ * The guest maps 0xffe00000 and copies the SSI registers into the area-7
+ * alias 0x1fe00000 (wavessi1/2 "SSI_Init, g_pSSI_TX_RegBase" strings).
+ * Keeping the registers readable makes that init succeed.  When a DMA
+ * channel targets a FIFO inside the block, ze0_ssi_play() forwards the
+ * bytes to a QEMU audio backend (-audiodev wav,id=...), so the PCM the
+ * guest produces ends up in a WAV file.  With no playback the file is
+ * silent.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "system/memory.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/sh4/ze0_hpbdmac.h"
+#include "hw/sh4/ze0_ssi.h"
+#include "system/address-spaces.h"
+#include "qemu/timer.h"
+
+#define SSI_NREG (ZE0_SSI_SIZE / 4)
+
+struct Ze0SsiState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t regs[SSI_NREG];
+    AudioBackend *audio_be;
+    SWVoiceOut *voice;
+    bool trace;
+    int32_t rate;
+    int32_t channels;
+    uint64_t pcm_bytes;
+    uint32_t pcm_transfers;
+    Ze0HpbDmacState *dmac;
+    QEMUTimer *selftest_timer;
+    uint32_t selftest_pcm;
+};
+
+/* Positive control for the model (not guest playback): push a sine wave
+ * through the same HPB-DMAC -> SSI -> audiodev path the driver uses. */
+static void ze0_ssi_selftest(void *opaque)
+{
+    Ze0SsiState *s = opaque;
+    uint8_t buf[4096];
+    unsigned i;
+    uint32_t n = s->selftest_pcm;
+
+    qemu_log_mask(LOG_UNIMP, "ze0-ssi: selftest callback n=%u dmac=%p\n",
+                  n, s->dmac);
+    if (!n || n > sizeof(buf) || !s->dmac) {
+        return;
+    }
+    for (i = 0; i < n; i += 4) {
+        int16_t v = ((i / 16) & 1) ? 12000 : -12000;
+        buf[i] = v & 0xff;
+        buf[i + 1] = (v >> 8) & 0xff;
+        buf[i + 2] = buf[i];
+        buf[i + 3] = buf[i + 1];
+    }
+    address_space_write(&address_space_memory, ZE0_SSI_SELFTEST_RAM,
+                        MEMTXATTRS_UNSPECIFIED, buf, n);
+    ze0_hpbdmac_selftest_audio(s->dmac, ZE0_SSI_SELFTEST_RAM, n);
+}
+
+bool ze0_ssi_is_fifo(uint32_t addr)
+{
+    uint32_t a = addr & 0x1fffffffu;
+
+    return a >= ZE0_SSI_BASE_A7 && a < ZE0_SSI_END_A7;
+}
+
+void ze0_ssi_play(Ze0SsiState *s, const uint8_t *buf, size_t n)
+{
+    size_t done;
+
+    if (!s || !s->voice || !n) {
+        return;
+    }
+    audio_be_set_active_out(s->audio_be, s->voice, true);
+    done = audio_be_write(s->audio_be, s->voice, (void *)buf, n);
+    s->pcm_bytes += done;
+    s->pcm_transfers++;
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-ssi: played %zu/%zu bytes (total %"
+                      PRIu64 ", transfers %u)\n", done, n, s->pcm_bytes,
+                      s->pcm_transfers);
+    }
+}
+
+void ze0_ssi_attach_dmac(Ze0SsiState *s, Ze0HpbDmacState *d)
+{
+    s->dmac = d;
+}
+
+static uint64_t ze0_ssi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Ze0SsiState *s = opaque;
+    uint64_t v = 0;
+    unsigned i;
+
+    for (i = 0; i < size && addr + i < ZE0_SSI_SIZE; i++) {
+        v |= (uint64_t)s->regs[(addr + i) / 4] << (8 * (i % 4));
+    }
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-ssi: read  @0x%05" HWADDR_PRIx
+                      " size %u -> 0x%" PRIx64 "\n", addr, size, v);
+    }
+    return v;
+}
+
+static void ze0_ssi_write(void *opaque, hwaddr addr, uint64_t value,
+                          unsigned size)
+{
+    Ze0SsiState *s = opaque;
+    unsigned i;
+
+    for (i = 0; i < size && addr + i < ZE0_SSI_SIZE; i++) {
+        s->regs[(addr + i) / 4] =
+            (s->regs[(addr + i) / 4] & ~(0xffu << (8 * (i % 4)))) |
+            ((value >> (8 * (i % 4))) & 0xffu) << (8 * (i % 4));
+    }
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-ssi: write @0x%05" HWADDR_PRIx
+                      " size %u <- 0x%" PRIx64 "\n", addr, size, value);
+    }
+}
+
+static const MemoryRegionOps ze0_ssi_ops = {
+    .read = ze0_ssi_read,
+    .write = ze0_ssi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 1,
+        .max_access_size = 4,
+    },
+};
+
+/* The audio backend pulls from a callback; PCM arrives through DMA instead. */
+static void ze0_ssi_callback(void *opaque, int free)
+{
+}
+
+static void ze0_ssi_realize(DeviceState *dev, Error **errp)
+{
+    Ze0SsiState *s = ZE0_SSI(dev);
+    struct audsettings as;
+
+    memory_region_init_io(&s->iomem, OBJECT(s), &ze0_ssi_ops, s, "ze0-ssi",
+                          ZE0_SSI_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+
+    s->selftest_timer = timer_new_ns(QEMU_CLOCK_REALTIME, ze0_ssi_selftest, s);
+    if (s->selftest_pcm) {
+        timer_mod(s->selftest_timer, qemu_clock_get_ns(QEMU_CLOCK_REALTIME) +
+                  2 * NANOSECONDS_PER_SECOND);
+    }
+
+    if (s->audio_be && audio_be_check(&s->audio_be, errp)) {
+        as.freq = s->rate;
+        as.nchannels = s->channels;
+        as.fmt = AUDIO_FORMAT_S16;
+        as.big_endian = false;
+        s->voice = audio_be_open_out(s->audio_be, s->voice, "ze0-ssi", s,
+                                     ze0_ssi_callback, &as);
+        if (!s->voice) {
+            error_setg(errp, "ze0-ssi: could not open playback voice");
+            return;
+        }
+    }
+}
+
+static const Property ze0_ssi_properties[] = {
+    DEFINE_AUDIO_PROPERTIES(Ze0SsiState, audio_be),
+    DEFINE_PROP_BOOL("trace", Ze0SsiState, trace, false),
+    DEFINE_PROP_INT32("rate", Ze0SsiState, rate, 48000),
+    DEFINE_PROP_INT32("channels", Ze0SsiState, channels, 2),
+    DEFINE_PROP_UINT32("selftest-pcm", Ze0SsiState, selftest_pcm, 0),
+};
+
+static void ze0_ssi_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ze0_ssi_realize;
+    device_class_set_props(dc, ze0_ssi_properties);
+}
+
+static const TypeInfo ze0_ssi_info = {
+    .name = TYPE_ZE0_SSI,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Ze0SsiState),
+    .class_init = ze0_ssi_class_init,
+};
+
+static void ze0_ssi_register(void)
+{
+    type_register_static(&ze0_ssi_info);
+}
+
+type_init(ze0_ssi_register)
