+++ b/include/hw/sh4/ze0_ssi.h
@@ -0,0 +1,35 @@
+/*
+ * ZE0 SSI audio block (TODO M8.H46).
+ *
+ * Two PCM streams leave the SoC over SSI: WaveSSI1 (PLAY_CH 12, REC_CH 11)
+ * and WaveSSI2 (PLAY_CH 13), both driven by the shared HPB-DMAC at
+ * 0xffc08000.  The register block is at 0xffe00000 (P4) with an area-7
+ * alias at 0x1fe00000; the three SSI channels are 0x10000 apart.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_SH4_ZE0_SSI_H
+#define HW_SH4_ZE0_SSI_H
+
+#include "hw/core/sysbus.h"
+#include "qemu/audio.h"
+
+#define TYPE_ZE0_SSI "ze0-ssi"
+OBJECT_DECLARE_SIMPLE_TYPE(Ze0SsiState, ZE0_SSI)
+
+#define ZE0_SSI_BASE        0xffe00000u
+#define ZE0_SSI_SIZE        0x30000u
+#define ZE0_SSI_BASE_A7     0x1fe00000u
+#define ZE0_SSI_END_A7      0x1fe30000u
+
+/** True when a DMA destination is a PCM FIFO of the SSI block. */
+bool ze0_ssi_is_fifo(uint32_t addr);
+#define ZE0_SSI_SELFTEST_RAM 0x09982000u
+
+/** Hand one DMA buffer of PCM bytes to the audio backend. */
+void ze0_ssi_play(Ze0SsiState *s, const uint8_t *buf, size_t n);
+
+/** Called by the machine init once the HPB-DMAC has been realized. */
+void ze0_ssi_attach_dmac(Ze0SsiState *s, struct Ze0HpbDmacState *d);
+
+#endif
