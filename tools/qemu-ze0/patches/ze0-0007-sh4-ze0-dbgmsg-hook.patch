@@ -75,6 +76,31 @@
  */
 #define ZE0_DEBUG_SCIF_BASE 0xffe46000u
 
+/*
+ * Kernel debug text on the debug serial port (TODO M8.B6).  EU2011 nk.exe
+ * never writes its debug strings to a UART: every NKDbgPrintfW ends in
+ * fn 0x880404f4 (r4 = the formatted UTF-16 string), which writes them to an
+ * AstLog buffer (0x88044478) and, when the words at 0x89e613b0/0x89e613b4
+ * are both 1, to the "DebugLog" log handle (0x8804048c); neither path
+ * touches 0xffe46000 (M8.A6, C-1281/C-1282).  dbgmsg=VA makes QEMU copy the
+ * string at r4 to serial port 0 whenever the instruction at VA executes,
+ * before it runs: an emulator-side HLE hook, no guest byte is changed.
+ * A string that does not end in '\n' gets one, so each message is a line.
+ * Default 0 = off (the boot writes 0 serial bytes, C-1281).
+ */
+static Chardev *ze0_dbgmsg_chr;
+
+static void ze0_dbgmsg_write(const uint8_t *buf, size_t len)
+{
+    if (ze0_dbgmsg_chr) {
+        qemu_chr_write(ze0_dbgmsg_chr, buf, len, true);
+        if (len && buf[len - 1] != '\n') {
+            /* one message per line: end an unterminated string */
+            qemu_chr_write(ze0_dbgmsg_chr, (const uint8_t *)"\n", 1, true);
+        }
+    }
+}
+
