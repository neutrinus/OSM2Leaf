@@ -116,6 +142,7 @@ struct Ze0MachineState {
     uint64_t app_off;
     bool tmu;
     bool ext_ram;
+    uint32_t dbgmsg_va;
 };
 
 #define ZE0_DEFAULT_KERNEL_OFF 0x3e00200u
@@ -363,6 +390,13 @@ static void ze0_init(MachineState *machine)
                                     sysbus_mmio_get_region(SYS_BUS_DEVICE(scif), 0));
     }
 
+    /* Kernel debug text on serial port 0 (M8.B6), off unless dbgmsg=VA. */
+    if (ZE0_MACHINE(machine)->dbgmsg_va) {
+        ze0_dbgmsg_chr = serial_hd(0);
+        sh4_dbgmsg_sink = ze0_dbgmsg_write;
+        sh4_dbgmsg_va = ZE0_MACHINE(machine)->dbgmsg_va;
+    }
