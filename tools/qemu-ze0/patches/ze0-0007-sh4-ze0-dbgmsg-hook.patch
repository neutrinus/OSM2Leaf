diff --git a/target/sh4/op_helper.c b/target/sh4/op_helper.c
index 44905ac..aef606f 100644
--- a/target/sh4/op_helper.c
+++ b/target/sh4/op_helper.c
@@ -78,6 +78,57 @@ void helper_raise_iaddr_error(CPUSH4State *env)
     raise_exception(env, 0x0e0, 0);
 }
 
+#ifndef CONFIG_USER_ONLY
+uint32_t sh4_dbgmsg_va;
+void (*sh4_dbgmsg_sink)(const uint8_t *buf, size_t len);
+
+#define SH4_DBGMSG_MAX_CHARS 1024
+
+/*
+ * Read the UTF-16LE string at r4 through the current MMU context (the way
+ * the gdbstub reads memory, no guest exception) and hand it to the sink as
+ * UTF-8.  Surrogates and unreadable memory end the string.
+ */
+void helper_dbgmsg(CPUSH4State *env)
+{
+    CPUState *cs = env_cpu(env);
+    bool bank1 = (env->sr & (1u << SR_MD)) && (env->sr & (1u << SR_RB));
+    uint32_t addr = env->gregs[bank1 ? 16 + 4 : 4];
+    uint8_t out[SH4_DBGMSG_MAX_CHARS * 3];
+    size_t n = 0;
+    int i;
+
+    if (!sh4_dbgmsg_sink) {
+        return;
+    }
+    for (i = 0; i < SH4_DBGMSG_MAX_CHARS; i++) {
+        uint8_t b[2];
+        uint16_t c;
+
+        if (cpu_memory_rw_debug(cs, addr + 2 * i, b, 2, false) != 0) {
+            break;
+        }
+        c = b[0] | (b[1] << 8);
+        if (c == 0 || (c >= 0xd800 && c <= 0xdfff)) {
+            break;
+        }
+        if (c < 0x80) {
+            out[n++] = c;
+        } else if (c < 0x800) {
+            out[n++] = 0xc0 | (c >> 6);
+            out[n++] = 0x80 | (c & 0x3f);
+        } else {
+            out[n++] = 0xe0 | (c >> 12);
+            out[n++] = 0x80 | ((c >> 6) & 0x3f);
+            out[n++] = 0x80 | (c & 0x3f);
+        }
+    }
+    if (n) {
+        sh4_dbgmsg_sink(out, n);
+    }
+}
+#endif
+
