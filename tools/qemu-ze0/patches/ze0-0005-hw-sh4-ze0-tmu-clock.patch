ze0: TMU input clock from the OAL, tmu= option (TODO M8.B2).

The EU2011 OAL timer descriptor (0x88004cf8) gives the TMU0 count rate
as 2 625 000 Hz; fn 0x8803d060 derives counts/ms 0xa41 and the maximum
period 0xc7ba8 ms from it, and TCR0 = 0x0021 selects Pphi/16.  The
peripheral clock passed to tmu012_init is therefore 42 MHz (was the
sh7750 default 60 MHz, a 1.43x fast CurMSec).  TMU ch3-5 (0xffd81000)
are not used by nk.exe and stay unmodelled.  New bool machine option
tmu= (default on); tmu=off leaves TMU ch0-2 unmapped, a negative
control for CurMSec.

Evidence and controls: docs/experiments/EXP-2026-11-20-M8.B2-ze0-tmu.md
(C-1320..C-1323).  Base: QEMU 8.2.10 + the earlier patches (sorts after
ze0-0004).

This file is the QEMU 11.1.3 form of the patch (TODO M8.A11): the text
above was written for the 8.2 series, where the patch was first made;
API names in it that 11.x renamed are listed in PORT-11.1.md.  Base: tag
v11.1.3 plus the earlier patches of this directory, in sorted order.

diff --git a/hw/sh4/ze0.c b/hw/sh4/ze0.c
index 50595a264..31b180c3d 100644
--- a/hw/sh4/ze0.c
+++ b/hw/sh4/ze0.c
@@ -68,11 +68,18 @@
  * TMU ch0-2 (TODO M8.B1/M8.B2).  EU2011 nk.exe fn 0x8803c9c6 programs
  * TMU0 at 0xffd80000 (TSTR +4, TCOR0 +8, TCNT0 +0xc, TCR0 +0x10 = 0x0021,
  * TCR1 +0x1c), the SH7750 layout of hw/timer/sh_timer.c; its ISR fn
- * 0x8803cb34 clears TCR0.UNF.  The peripheral clock is not established
- * (HYPOTHESIS: 60 MHz, the sh7750 default); M8.B2 owns the tick rate.
+ * 0x8803cb34 clears TCR0.UNF.
+ *
+ * Peripheral clock (M8.B2): the OAL timer descriptor at 0x88004cf8 gives
+ * the TMU count rate as 2 625 000 Hz (counts per ms = 0xa41 at
+ * 0x89e6cad8), and TCR0 = 0x0021 selects Pphi/16, so Pphi = 42 MHz.  With
+ * that rate CurMSec (0x89e41888) follows QEMU's virtual clock.  TMU ch3-5
+ * (0xffd81000) are not touched by nk.exe and are not modelled.  The
+ * machine option tmu=off leaves the TMU unmapped (negative control).
  */
 #define ZE0_TMU012_BASE     0x1fd80000u
-#define ZE0_PERIPH_FREQ     60000000u
+#define ZE0_TMU_COUNT_HZ    2625000u
+#define ZE0_PERIPH_FREQ     (ZE0_TMU_COUNT_HZ * 16u)
 
 /*
  * Built-in CE image loader (TODO M8.A3).  The ZE0 SD card has no boot
@@ -96,6 +103,7 @@ struct Ze0MachineState {
     MachineState parent_obj;
     uint64_t kernel_off;
     uint64_t app_off;
+    bool tmu;
 };
 
 #define ZE0_DEFAULT_KERNEL_OFF 0x3e00200u
@@ -302,11 +310,14 @@ static void ze0_init(MachineState *machine)
 
         qdev_realize_and_unref(DEVICE(intc), NULL, &error_fatal);
         cpu->env.intc_handle = ze0_intc_handle(intc);
-        tmu012_init(sysmem, ZE0_TMU012_BASE,
-                    TMU012_FEAT_TOCR | TMU012_FEAT_3CHAN, ZE0_PERIPH_FREQ,
-                    ze0_intc_irq(intc, ZE0_IRQ_TMU0),
-                    ze0_intc_irq(intc, ZE0_IRQ_TMU1),
-                    ze0_intc_irq(intc, ZE0_IRQ_TMU2), NULL);
+        if (ZE0_MACHINE(machine)->tmu) {
+            tmu012_init(sysmem, ZE0_TMU012_BASE,
+                        TMU012_FEAT_TOCR | TMU012_FEAT_3CHAN,
+                        ZE0_PERIPH_FREQ,
+                        ze0_intc_irq(intc, ZE0_IRQ_TMU0),
+                        ze0_intc_irq(intc, ZE0_IRQ_TMU1),
+                        ze0_intc_irq(intc, ZE0_IRQ_TMU2), NULL);
+        }
     }
 
     /* Kernel debug SCIF (M8.A6) on serial port 0, over the P4 catch-all. */
@@ -328,12 +339,26 @@ static void ze0_init(MachineState *machine)
     ze0_load_images(ZE0_MACHINE(machine), cpu);
 }
 
+static bool ze0_get_tmu(Object *obj, Error **errp)
+{
+    return ZE0_MACHINE(obj)->tmu;
+}
+
+static void ze0_set_tmu(Object *obj, bool value, Error **errp)
+{
+    ZE0_MACHINE(obj)->tmu = value;
+}
+
 static void ze0_machine_instance_init(Object *obj)
 {
     Ze0MachineState *s = ZE0_MACHINE(obj);
 
     s->kernel_off = ZE0_DEFAULT_KERNEL_OFF;
     s->app_off = ZE0_DEFAULT_APP_OFF;
+    s->tmu = true;
+    object_property_add_bool(obj, "tmu", ze0_get_tmu, ze0_set_tmu);
+    object_property_set_description(obj, "tmu",
+        "map TMU ch0-2 at 0xffd80000 (default on; off = negative control)");
     object_property_add_uint64_ptr(obj, "kernel-off", &s->kernel_off,
                                    OBJ_PROP_FLAG_READWRITE);
     object_property_set_description(obj, "kernel-off",
