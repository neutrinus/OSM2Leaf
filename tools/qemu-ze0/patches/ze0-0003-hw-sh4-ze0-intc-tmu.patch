diff --git a/hw/sh4/ze0_intc.c b/hw/sh4/ze0_intc.c
new file mode 100644
index 000000000..bf30a677f
--- /dev/null
+++ b/hw/sh4/ze0_intc.c
@@ -0,0 +1,264 @@
+/*
+ * ZE0 (Nissan Leaf ZE0 navigation unit, SH-4A) interrupt controller model
+ *
+ * TODO M8.B1.  Register layout read from the EU2011 nk.exe OAL (VAs are
+ * EU2011, image B at 0x3e00200; tools/sh4dis.py, tools/ze0_serial.py refs):
+ *
+ *   0xff802000 INTC block, written once by BSPIntrInit fn 0x8803dc70:
+ *     +0x00 ICR0 (0x00800000), +0x10 INTPRI (0xd0000000), +0x1c ICR1
+ *     (0x80000000), +0x44/+0x48 INTMSK0/1 (0xff000000, write 1 = mask),
+ *     +0x64 INTMSKCLR0 (write 1 = unmask, 0x80000000).
+ *   0xff804000 INT2 block:
+ *     +0x00..+0x1c INT2PRI0..7 (BSPIntrInit and the timer hook fn
+ *     0x8803d168: INT2PRI0 = 0x08020202, INT2PRI1 = 0x02020012),
+ *     +0x40 INT2MSKR  (write 1 = mask;   BSPIntrInit writes 0xffffffff),
+ *     +0x44 INT2MSKCR (write 1 = unmask; the ISRs and OEMInterruptEnable/
+ *     Disable/Done use the pair 0xff804040/0xff804044 for 80+ sites).
+ *
+ * The kernel's interrupt entry (VBR+0x600, VBR = 0x8800ec10) reads INTEVT
+ * from 0xff000028 (the CCN) and indexes InterruptTable[INTEVT >> 5].  The
+ * timer hook fn 0x8803d168 puts the TMU0 ISR fn 0x8803cb34 at INTEVT 0x400
+ * (and 0x8803d260 at 0x440), sets INT2PRI0 and then unmasks INT2 bit 1
+ * (INT2MSKCR = 2).  So: TMU ch0..2 = INTEVT 0x400/0x420/0x440, INT2 bit 1.
+ *
+ * Priority: the level compared with SR.IMASK is the 5-bit INT2PRI field
+ * >> 1 (SH-4A INT2 convention).  TMU0/1/2 use INT2PRI0 bits 20:16 / 12:8 /
+ * 4:0 (0x02 each -> level 1).  Derived, not documented: the kernel's
+ * entry stub (0x8800f248..0x8800f276) lowers SR.IMASK to IntrPrio[INTEVT]
+ * before calling the ISR, and the timer hook sets IntrPrio = 1 for 0x400
+ * and 0x440, so the source's own level must be 1; with bits 28:24 (0x08,
+ * level 4) the still-asserted TMU0 re-enters at 0x8800f278 forever
+ * (EXP-2026-11-20-M8.B1-intc-model).  A level-0 source is never delivered.
+ *
+ * Everything else in both blocks is plain read-back storage.  Only the
+ * sources below are wired; any other INT2 bit can be masked/unmasked but
+ * never asserts.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "system/address-spaces.h"
+#include "system/memory.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev.h"
+#include "hw/sh4/sh_intc.h"
+#include "hw/sh4/ze0_intc.h"
+#include "target/sh4/cpu.h"
+
+#define ZE0_INTC_BASE   0xff802000u
+#define ZE0_INT2_BASE   0xff804000u
+#define ZE0_BLOCK_SIZE  0x100u
+
+#define INTMSK0     0x44
+#define INTMSK1     0x48
+#define INTMSKCLR0  0x64
+#define INT2MSKR    0x40
+#define INT2MSKCR   0x44
+
+typedef struct Ze0IntcSource {
+    const char *name;
+    uint16_t intevt;
+    uint8_t int2_bit;
+    uint8_t pri_reg;     /* INT2PRIn word index */
+    uint8_t pri_shift;   /* 5-bit field position */
+} Ze0IntcSource;
+
+static const Ze0IntcSource ze0_sources[ZE0_INTC_NR_SOURCES] = {
+    [ZE0_IRQ_TMU0] = { "TMU0", 0x400, 1, 0, 16 },
+    [ZE0_IRQ_TMU1] = { "TMU1", 0x420, 1, 0, 8 },
+    [ZE0_IRQ_TMU2] = { "TMU2", 0x440, 1, 0, 0 },
+};
+
+struct Ze0IntcState {
+    DeviceState parent_obj;
+
+    MemoryRegion intc_mr;
+    MemoryRegion int2_mr;
+    uint32_t intc[ZE0_BLOCK_SIZE / 4];
+    uint32_t int2[ZE0_BLOCK_SIZE / 4];
+    int asserted[ZE0_INTC_NR_SOURCES];
+    struct intc_desc desc;   /* CPU-facing handle (env->intc_handle) */
+    qemu_irq *irqs;
+};
+
+static int ze0_intc_level(Ze0IntcState *s, int n)
+{
+    const Ze0IntcSource *src = &ze0_sources[n];
+    uint32_t field = (s->int2[src->pri_reg] >> src->pri_shift) & 0x1f;
+
+    return field >> 1;
+}
+
+static void ze0_intc_update(Ze0IntcState *s)
+{
+    int n, pending = 0;
+
+    for (n = 0; n < ZE0_INTC_NR_SOURCES; n++) {
+        struct intc_source *is = &s->desc.sources[n];
+        int masked = (s->int2[INT2MSKR / 4] >> ze0_sources[n].int2_bit) & 1;
+        int level = ze0_intc_level(s, n);
+
+        is->vect = ze0_sources[n].intevt;
+        is->prio = level;
+        is->pending = s->asserted[n] && !masked && level > 0;
+        pending += is->pending;
+    }
+    s->desc.pending = pending;
+    if (pending) {
+        cpu_interrupt(first_cpu, CPU_INTERRUPT_HARD);
+    } else {
+        cpu_reset_interrupt(first_cpu, CPU_INTERRUPT_HARD);
+    }
+}
+
+static void ze0_intc_set_irq(void *opaque, int n, int level)
+{
+    Ze0IntcState *s = opaque;
+
+    s->asserted[n] = !!level;
+    ze0_intc_update(s);
+}
+
+static uint64_t ze0_intc_read(void *opaque, hwaddr off, unsigned size)
+{
+    Ze0IntcState *s = opaque;
+
+    if (off == INTMSKCLR0) {
+        return 0;
+    }
+    return s->intc[off / 4];
+}
+
+static void ze0_intc_write(void *opaque, hwaddr off, uint64_t val,
+                           unsigned size)
+{
+    Ze0IntcState *s = opaque;
+
+    switch (off) {
+    case INTMSK0:
+    case INTMSK1:
+        s->intc[off / 4] |= val;
+        break;
+    case INTMSKCLR0:
+        s->intc[INTMSK0 / 4] &= ~val;
+        break;
+    default:
+        s->intc[off / 4] = val;
+        break;
+    }
+}
+
+static uint64_t ze0_int2_read(void *opaque, hwaddr off, unsigned size)
+{
+    Ze0IntcState *s = opaque;
+
+    if (off == INT2MSKCR) {
+        return 0;
+    }
+    return s->int2[off / 4];
+}
+
+static void ze0_int2_write(void *opaque, hwaddr off, uint64_t val,
+                           unsigned size)
+{
+    Ze0IntcState *s = opaque;
+
+    switch (off) {
+    case INT2MSKR:
+        s->int2[INT2MSKR / 4] |= val;
+        break;
+    case INT2MSKCR:
+        s->int2[INT2MSKR / 4] &= ~val;
+        break;
+    default:
+        s->int2[off / 4] = val;
+        break;
+    }
+    ze0_intc_update(s);
+}
+
+static const MemoryRegionOps ze0_intc_ops = {
+    .read = ze0_intc_read,
+    .write = ze0_intc_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static const MemoryRegionOps ze0_int2_ops = {
+    .read = ze0_int2_read,
+    .write = ze0_int2_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void ze0_intc_reset(DeviceState *dev)
+{
+    Ze0IntcState *s = ZE0_INTC(dev);
+
+    memset(s->intc, 0, sizeof(s->intc));
+    memset(s->int2, 0, sizeof(s->int2));
+    s->int2[INT2MSKR / 4] = 0xffffffff;   /* all INT2 sources masked */
+    s->intc[INTMSK0 / 4] = 0xff000000;
+    ze0_intc_update(s);
+}
+
+static void ze0_intc_realize(DeviceState *dev, Error **errp)
+{
+    Ze0IntcState *s = ZE0_INTC(dev);
+    MemoryRegion *sysmem = get_system_memory();
+    int n;
+
+    memory_region_init_io(&s->intc_mr, OBJECT(dev), &ze0_intc_ops, s,
+                          "ze0-intc", ZE0_BLOCK_SIZE);
+    memory_region_init_io(&s->int2_mr, OBJECT(dev), &ze0_int2_ops, s,
+                          "ze0-int2", ZE0_BLOCK_SIZE);
+    memory_region_add_subregion_overlap(sysmem, ZE0_INTC_BASE, &s->intc_mr, 1);
+    memory_region_add_subregion_overlap(sysmem, ZE0_INT2_BASE, &s->int2_mr, 1);
+
+    s->desc.nr_sources = ZE0_INTC_NR_SOURCES;
+    s->desc.sources = g_new0(struct intc_source, ZE0_INTC_NR_SOURCES);
+    for (n = 0; n < ZE0_INTC_NR_SOURCES; n++) {
+        s->desc.sources[n].parent = &s->desc;
+        s->desc.sources[n].vect = ze0_sources[n].intevt;
+    }
+    s->irqs = qemu_allocate_irqs(ze0_intc_set_irq, s, ZE0_INTC_NR_SOURCES);
+    /* a plain TYPE_DEVICE sits on no bus and gets no system reset */
+    ze0_intc_reset(dev);
+}
+
+qemu_irq ze0_intc_irq(Ze0IntcState *s, int n)
+{
+    return s->irqs[n];
+}
+
+struct intc_desc *ze0_intc_handle(Ze0IntcState *s)
+{
+    return &s->desc;
+}
+
+static void ze0_intc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = ze0_intc_realize;
+    device_class_set_legacy_reset(dc, ze0_intc_reset);
+    dc->user_creatable = false;
+}
+
+static const TypeInfo ze0_intc_type_info = {
+    .name = TYPE_ZE0_INTC,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(Ze0IntcState),
+    .class_init = ze0_intc_class_init,
+};
+
+static void ze0_intc_register_types(void)
+{
+    type_register_static(&ze0_intc_type_info);
+}
+
+type_init(ze0_intc_register_types)
