--- a/hw/intc/sh_intc.c
+++ b/hw/intc/sh_intc.c
@@ -88,15 +88,35 @@ int sh_intc_get_pending_vector(struct intc_desc *desc, int imask)
         return -1; /* FIXME, update code to include priority per source */
     }
 
-    for (i = 0; i < desc->nr_sources; i++) {
-        struct intc_source *source = &desc->sources[i];
-
-        if (source->pending) {
-            trace_sh_intc_pending(desc->pending, source->vect);
-            return source->vect;
+    {
+        /*
+         * A source with prio != 0 (set only by models that track the
+         * level, e.g. ze0-intc) is taken only above SR.IMASK, highest
+         * level first; prio == 0 keeps the historical first-pending rule.
+         */
+        int best = -1, best_prio = -1;
+
+        for (i = 0; i < desc->nr_sources; i++) {
+            struct intc_source *source = &desc->sources[i];
+
+            if (!source->pending) {
+                continue;
+            }
+            if (!source->prio) {
+                trace_sh_intc_pending(desc->pending, source->vect);
+                return source->vect;
+            }
+            if (source->prio > imask && source->prio > best_prio) {
+                best = i;
+                best_prio = source->prio;
+            }
+        }
+        if (best >= 0) {
+            trace_sh_intc_pending(desc->pending, desc->sources[best].vect);
+            return desc->sources[best].vect;
         }
+        return -1;
     }
-    g_assert_not_reached();
 }
 
