@@ -0,0 +1,26 @@
+/*
+ * ZE0 interrupt controller model (TODO M8.B1); see hw/sh4/ze0_intc.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_SH4_ZE0_INTC_H
+#define HW_SH4_ZE0_INTC_H
+
+#include "qom/object.h"
+#include "hw/core/irq.h"
+#include "hw/sh4/sh_intc.h"
+
+#define TYPE_ZE0_INTC "ze0-intc"
+OBJECT_DECLARE_SIMPLE_TYPE(Ze0IntcState, ZE0_INTC)
+
+enum {
+    ZE0_IRQ_TMU0,
+    ZE0_IRQ_TMU1,
+    ZE0_IRQ_TMU2,
+    ZE0_INTC_NR_SOURCES
+};
+
+qemu_irq ze0_intc_irq(Ze0IntcState *s, int n);
+struct intc_desc *ze0_intc_handle(Ze0IntcState *s);
+
+#endif
