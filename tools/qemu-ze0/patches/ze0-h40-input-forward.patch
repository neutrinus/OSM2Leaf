+/*
+ * QMP input forwarding (TODO M8.H40).  The console exposed by M8.H4 has no
+ * input handler of its own, so `input-send-event` finds nothing to dispatch
+ * to.  Register a handler bound to ze0-gfx and forward absolute pointer
+ * moves, left-button transitions and key events to a host chardev as textual
+ * commands the panel peer can replay over the SCI3 display-unit link:
+ *
+ *   abs x VALUE\n  abs y VALUE\n  btn left down|up\n  key QCODE down|up\n
+ *
+ * Values are 0..0x7fff (QEMU INPUT_EVENT_ABS_MIN/MAX); we scale to the
+ * 800x480 DU using max_out 799/479 (SCREEN_W-1/SCREEN_H-1), which round-trips
+ * panel (765,70) to (0x7a8d,0x12b5) and back (M8.H39).
+ */
+static void ze0_gfx_input_write(Ze0GfxState *s, const char *fmt, ...)
+    G_GNUC_PRINTF(2, 3);
+
+static void ze0_gfx_input_write(Ze0GfxState *s, const char *fmt, ...)
+{
+    char buf[128];
+    va_list ap;
+    int n;
+
+    if (!s->input_chr) {
+        return;
+    }
+    va_start(ap, fmt);
+    n = vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    if (n > 0) {
+        qemu_chr_fe_write(&s->input_fe, (const uint8_t *)buf, n);
+    }
+}
+
+static void ze0_gfx_input_event(DeviceState *dev, QemuConsole *src,
+                                QemuInputEvent *evt)
+{
+    Ze0GfxState *s = ZE0_GFX(dev);
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_ABS:
+        if (evt->abs.axis == INPUT_AXIS_X) {
+            s->input_x = qemu_input_scale_axis(evt->abs.value,
+                         INPUT_EVENT_ABS_MIN, INPUT_EVENT_ABS_MAX, 0, 799);
+            ze0_gfx_input_write(s, "abs x %d\n", s->input_x);
+        } else if (evt->abs.axis == INPUT_AXIS_Y) {
+            s->input_y = qemu_input_scale_axis(evt->abs.value,
+                         INPUT_EVENT_ABS_MIN, INPUT_EVENT_ABS_MAX, 0, 479);
+            ze0_gfx_input_write(s, "abs y %d\n", s->input_y);
+        }
+        break;
+    case INPUT_EVENT_KIND_BTN:
+        if (evt->btn.button == INPUT_BUTTON_LEFT) {
+            ze0_gfx_input_write(s, "btn left %s\n", evt->btn.down ? "down" : "up");
+        }
+        break;
+    case INPUT_EVENT_KIND_KEY:
+        /* evt->key.key is a Linux keycode; QKeyCode_str indexes QKeyCode. */
+        ze0_gfx_input_write(s, "key %s %s\n",
+                            QKeyCode_str(qemu_input_linux_to_qcode(evt->key.key)),
+                            evt->key.down ? "down" : "up");
+        break;
+    default:
+        break;
+    }
+}
+
+static const QemuInputHandler ze0_gfx_input_handler = {
+    .name  = "ze0-gfx QMP input",
+    .mask  = INPUT_EVENT_MASK_ABS | INPUT_EVENT_MASK_BTN |
+             INPUT_EVENT_MASK_KEY,
+    .event = ze0_gfx_input_event,
+};
+
 static uint64_t ze0_gfx_rd(Ze0GfxState *s, int blk, hwaddr off, unsigned size)
 {
     uint8_t *m = s->regs[blk] + off;
@@ -371,6 +448,20 @@
                                              &ze0_gfx_display_ops, s);
         qemu_console_resize(s->con, ZE0_DU_W, ZE0_DU_H);
         s->surface = qemu_console_surface(s->con);
+        if (s->input_chr) {
+            Chardev *chr = qemu_chr_find(s->input_chr);
+
+            if (!chr) {
+                error_report("ze0-gfx: input: no chardev with id '%s'",
+                             s->input_chr);
+                exit(1);
+            }
+            qemu_chr_fe_init(&s->input_fe, chr, &error_fatal);
+            s->input_handler = qemu_input_handler_register(DEVICE(s),
+                                    &ze0_gfx_input_handler);
+            qemu_input_handler_bind(s->input_handler, "ze0-gfx", 0,
+                                    &error_fatal);
+        }
     }
 }
 
