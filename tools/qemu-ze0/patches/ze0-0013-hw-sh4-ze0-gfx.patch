@@ -0,0 +1,26 @@
+/* ZE0 display engine registers (TODO M8.C1e). SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_SH4_ZE0_GFX_H
+#define HW_SH4_ZE0_GFX_H
+
+#include "hw/core/sysbus.h"
+#include "qemu/timer.h"
+
+#define TYPE_ZE0_GFX "ze0-gfx"
+OBJECT_DECLARE_SIMPLE_TYPE(Ze0GfxState, ZE0_GFX)
+
+#define ZE0_GFX_DU_BASE   0xfff80000u
+#define ZE0_GFX_2DG_BASE  0xffe80000u
+#define ZE0_GFX_SIZE      0x10000u
+
+struct Ze0GfxState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio[2];
+    qemu_irq irq[2];
+    bool trace;
+    uint8_t regs[2][ZE0_GFX_SIZE];
+    QEMUTimer *vbl;
+    uint32_t du_sr, g2_sr;
+    uint64_t vblanks, g2_kicks;
+};
+
+#endif
