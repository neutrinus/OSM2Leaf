diff --git a/hw/sh4/ze0_gfx.c b/hw/sh4/ze0_gfx.c
new file mode 100644
index 000000000..9974a6d98
--- /dev/null
+++ b/hw/sh4/ze0_gfx.c
@@ -0,0 +1,216 @@
+/*
+ * ZE0 display engine (TODO M8.C1e): DU vblank + 2DG handshake, with trace.
+ *
+ * gdisubdrv.dll maps two register blocks with VirtualCopy(PAGE_PHYSICAL):
+ * phys 0xfff80000 (display unit, "DU") and 0xffe80000 (2D engine, "2DG").
+ * Through the TLB the guest reaches them at the 29-bit aliases
+ * 0x1ff80000 / 0x1fe80000, where -M ze0 had no device (EXP-2026-11-22-
+ * M8.C1d O8).  This device answers both windows (and their P4 addresses)
+ * with read-back storage plus the few bits the firmware waits for:
+ *
+ *  - DU: a 60 Hz vblank sets DSSR (+0x08) bit 11; DSRCR (+0x0c) clears
+ *    it; the line is DSSR & DIER (+0x10).  OAL ISR fn 0x8803fc64
+ *    (INTEVT 0x3e0, SYSINTR 33) feeds IntrThread_DU.
+ *  - 2DG: the driver writes the display list address to DLSAR (+0x48)
+ *    and starts it with SCLR (+0x00) = 1; the list is NOT executed, the
+ *    model only sets SR (+0x04) bit 0 (TRA, list end); SRCR (+0x08)
+ *    clears it; the line is SR & IER (+0x0c).  OAL ISR fn 0x8803fbcc
+ *    (INTEVT 0x780, SYSINTR 34) feeds IntrThread_2DG.
+ *
+ * trace=on logs every other access with the guest PC under -d unimp
+ * (status polls and the per-frame DSRCR write are left out).
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/cpu.h"
+#include "target/sh4/cpu.h"
+#include "hw/sh4/ze0_gfx.h"
+#include "qemu/timer.h"
+
+/* DU registers (offsets seen in the gdisubdrv.dll init and the OAL ISR). */
+#define DU_DSYSR    0x00
+#define DU_DSSR     0x08    /* status, read by ISR fn 0x8803fc64 */
+#define DU_DSRCR    0x0c    /* status clear (write 1) */
+#define DU_DIER     0x10    /* interrupt enable */
+#define DU_VBK      0x800   /* vertical blank */
+/* 2DG registers (ISR fn 0x8803fbcc). */
+#define G2_SCLR     0x00
+#define G2_SR       0x04
+#define G2_SRCR     0x08
+#define G2_IER      0x0c
+#define G2_TRA      0x01    /* display list end */
+
+static uint32_t ze0_gfx_pc(void)
+{
+    return current_cpu ? SUPERH_CPU(current_cpu)->env.pc : 0;
+}
+
+static uint32_t ze0_reg(Ze0GfxState *s, int blk, hwaddr off)
+{
+    return ldl_le_p(s->regs[blk] + off);
+}
+
+static void ze0_gfx_update(Ze0GfxState *s)
+{
+    qemu_set_irq(s->irq[0], !!(s->du_sr & ze0_reg(s, 0, DU_DIER)));
+    qemu_set_irq(s->irq[1], !!(s->g2_sr & ze0_reg(s, 1, G2_IER)));
+}
+
+static void ze0_gfx_vblank(void *opaque)
+{
+    Ze0GfxState *s = opaque;
+
+    s->du_sr |= DU_VBK;
+    s->vblanks++;
+    ze0_gfx_update(s);
+    timer_mod(s->vbl, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              NANOSECONDS_PER_SECOND / 60);
+}
+
+static uint64_t ze0_gfx_rd(Ze0GfxState *s, int blk, hwaddr off, unsigned size)
+{
+    uint8_t *m = s->regs[blk] + off;
+    uint64_t v = size == 4 ? ldl_le_p(m) : size == 2 ? lduw_le_p(m) : *m;
+
+    if (blk == 0 && off == DU_DSSR && size == 4) {
+        v = s->du_sr;
+    } else if (blk == 1 && off == G2_SR && size == 4) {
+        v = s->g2_sr;
+    }
+    if (s->trace && ((blk == 0 && off == DU_DSSR) ||
+                     (blk == 1 && off == G2_SR))) {
+        return v;       /* polled status: keep the log readable */
+    }
+
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-gfx: %s rd +0x%04x/%u = 0x%08" PRIx64
+                      " pc 0x%08x\n", blk ? "2dg" : "du", (unsigned)off,
+                      size, v, ze0_gfx_pc());
+    }
+    return v;
+}
+
+static void ze0_gfx_wr(Ze0GfxState *s, int blk, hwaddr off, uint64_t v,
+                       unsigned size)
+{
+    uint8_t *m = s->regs[blk] + off;
+
+    if (s->trace && !(blk == 0 && off == DU_DSRCR)) {
+        qemu_log_mask(LOG_UNIMP, "ze0-gfx: %s wr +0x%04x/%u = 0x%08" PRIx64
+                      " pc 0x%08x\n", blk ? "2dg" : "du", (unsigned)off,
+                      size, v, ze0_gfx_pc());
+    }
+    if (size == 4 && blk == 0 && off == DU_DSRCR) {
+        s->du_sr &= ~v;
+    } else if (size == 4 && blk == 1 && off == G2_SRCR) {
+        s->g2_sr &= ~v;
+    }
+    if (size == 4) {
+        stl_le_p(m, v);
+    } else if (size == 2) {
+        stw_le_p(m, v);
+    } else {
+        *m = v;
+    }
+    if (blk == 1 && off == G2_SCLR && size == 4 && (v & 1)) {
+        /*
+         * Display list start: the driver writes DLSAR (+0x48) and then
+         * SCLR = 1 (fn 0x3af3e14..0x3af3e1e).  The list is not executed
+         * yet; report it finished (SR.TRA) so the IntrThread_2DG ->
+         * InterruptDone(34) handshake completes.
+         */
+        s->g2_kicks++;
+        s->g2_sr |= G2_TRA;
+        stl_le_p(m, v & ~1u);
+    }
+    ze0_gfx_update(s);
+}
+
+static uint64_t ze0_du_read(void *o, hwaddr a, unsigned s)
+{
+    return ze0_gfx_rd(o, 0, a, s);
+}
+
+static void ze0_du_write(void *o, hwaddr a, uint64_t v, unsigned s)
+{
+    ze0_gfx_wr(o, 0, a, v, s);
+}
+
+static uint64_t ze0_2dg_read(void *o, hwaddr a, unsigned s)
+{
+    return ze0_gfx_rd(o, 1, a, s);
+}
+
+static void ze0_2dg_write(void *o, hwaddr a, uint64_t v, unsigned s)
+{
+    ze0_gfx_wr(o, 1, a, v, s);
+}
+
+static const MemoryRegionOps ze0_du_ops = {
+    .read = ze0_du_read, .write = ze0_du_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static const MemoryRegionOps ze0_2dg_ops = {
+    .read = ze0_2dg_read, .write = ze0_2dg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void ze0_gfx_realize(DeviceState *dev, Error **errp)
+{
+    Ze0GfxState *s = ZE0_GFX(dev);
+
+    memory_region_init_io(&s->mmio[0], OBJECT(s), &ze0_du_ops, s,
+                          "ze0-gfx-du", ZE0_GFX_SIZE);
+    memory_region_init_io(&s->mmio[1], OBJECT(s), &ze0_2dg_ops, s,
+                          "ze0-gfx-2dg", ZE0_GFX_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->mmio[0]);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->mmio[1]);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq[0]);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq[1]);
+    s->vbl = timer_new_ns(QEMU_CLOCK_VIRTUAL, ze0_gfx_vblank, s);
+}
+
+static void ze0_gfx_reset(DeviceState *dev)
+{
+    Ze0GfxState *s = ZE0_GFX(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->du_sr = s->g2_sr = 0;
+    timer_mod(s->vbl, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              NANOSECONDS_PER_SECOND / 60);
+}
+
+static const Property ze0_gfx_props[] = {
+    DEFINE_PROP_BOOL("trace", Ze0GfxState, trace, false),
+};
+
+static void ze0_gfx_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = ze0_gfx_realize;
+    device_class_set_legacy_reset(dc, ze0_gfx_reset);
+    device_class_set_props(dc, ze0_gfx_props);
+}
+
+static const TypeInfo ze0_gfx_info = {
+    .name = TYPE_ZE0_GFX,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Ze0GfxState),
+    .class_init = ze0_gfx_class_init,
+};
+
+static void ze0_gfx_register(void)
+{
+    type_register_static(&ze0_gfx_info);
+}
+type_init(ze0_gfx_register)
