@@ -0,0 +1,41 @@
+/*
+ * ZE0 SD host (TODO M8.C10); see hw/sh4/ze0_sdhi.c.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_SH4_ZE0_SDHI_H
+#define HW_SH4_ZE0_SDHI_H
+
+#include "hw/core/sysbus.h"
+#include "hw/sd/sd.h"
+#include "qom/object.h"
+
+#define TYPE_ZE0_SDHI "ze0-sdhi"
+OBJECT_DECLARE_SIMPLE_TYPE(Ze0SdhiState, ZE0_SDHI)
+
+struct Ze0SdhiState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    SDBus sdbus;
+    qemu_irq irq;
+    uint8_t port;
+    bool trace;
+
+    uint16_t cmd;
+    uint8_t cmd_index;
+    bool app_cmd;
+    uint16_t rca;
+    uint32_t arg;
+    uint16_t stop;
+    uint16_t seccnt;
+    uint16_t rsp[8];
+    uint16_t info1, info2, info1_mask, info2_mask;
+    uint16_t clk_ctrl, size, option;
+    uint16_t sdio_mode, sdio_info1, sdio_info1_mask;
+    uint16_t cc_ext_mode, host_mode;
+    int xfer;
+    uint32_t blk_left;
+    uint32_t blocks_left;
+};
+
+#endif
