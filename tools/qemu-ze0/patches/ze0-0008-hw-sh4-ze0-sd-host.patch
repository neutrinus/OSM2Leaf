diff --git a/hw/sh4/ze0_sdhi.c b/hw/sh4/ze0_sdhi.c
new file mode 100644
index 000000000..b226602f3
--- /dev/null
+++ b/hw/sh4/ze0_sdhi.c
@@ -0,0 +1,410 @@
+/*
+ * ZE0 SD host (TODO M8.C10): a minimal Renesas SDHI / TMIO-style
+ * controller for the EU2011 SDHC.dll, driving QEMU's SD card model.
+ *
+ * Evidence (EU2011 SDHC.dll build B): the card-detect read fn 0x039bcedc
+ * tests bit 5 (0x20) of the 16-bit register at +0x1c (SD_INFO1) of the
+ * mapped host and reports "card present" only when it is set; the host
+ * init fn 0x039bcf20 writes +0x20/+0x22 (SD_INFO1/2 masks), +0x38
+ * (SDIO_INFO1 mask) and +0xd8 (CC_EXT_MODE).  Two channels at
+ * 0xffe4c000 (port 0) and 0xffe4d000 (port 1), 16-bit registers, no
+ * address shift.  Register layout and bit meanings: the public SDHI/TMIO
+ * map (Linux drivers/mmc/host/tmio_mmc.h).
+ *
+ * Model: commands complete synchronously (SD_INFO1.RSPEND on the write of
+ * SD_CMD); data moves by PIO through SD_BUF0 (SD_INFO2.BRE/BWE per block,
+ * SD_INFO1.ACCESSEND after the last one).  Status bits are cleared by
+ * writing 0 (write-0-to-clear).  An optional IRQ line follows
+ * (INFO1 & ~MASK1) | (INFO2 & ~MASK2 & error/BRE/BWE).  DMA (CC_EXT_MODE
+ * bit 1) is not modelled.  Every register access can be traced with
+ * -d unimp (LOG_UNIMP) for driver bring-up.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qapi/error.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/sd/sd.h"
+#include "hw/sh4/ze0_sdhi.h"
+
+#define SD_CMD          0x00
+#define SD_ARG0         0x04
+#define SD_ARG1         0x06
+#define SD_STOP         0x08
+#define SD_SECCNT       0x0a
+#define SD_RSP0         0x0c    /* .. 0x1a: RSP0..RSP7 */
+#define SD_INFO1        0x1c
+#define SD_INFO2        0x1e
+#define SD_INFO1_MASK   0x20
+#define SD_INFO2_MASK   0x22
+#define SD_CLK_CTRL     0x24
+#define SD_SIZE         0x26
+#define SD_OPTION       0x28
+#define SD_ERR_STS1     0x2c
+#define SD_ERR_STS2     0x2e
+#define SD_BUF0         0x30
+#define SDIO_MODE       0x34
+#define SDIO_INFO1      0x36
+#define SDIO_INFO1_MASK 0x38
+#define CC_EXT_MODE     0xd8
+#define SOFT_RST        0xe0
+#define SD_VERSION      0xe2
+#define HOST_MODE       0xe4
+
+#define INFO1_RSPEND    0x0001
+#define INFO1_ACCEND    0x0004
+#define INFO1_REMOVE    0x0008
+#define INFO1_INSERT    0x0010
+#define INFO1_CD        0x0020
+#define INFO1_WP        0x0080  /* 1 = writable */
+
+#define INFO2_CMDE      0x0001
+#define INFO2_DTO       0x0008
+#define INFO2_RSPTO     0x0040
+#define INFO2_DAT0      0x0080
+#define INFO2_BRE       0x0100
+#define INFO2_BWE       0x0200
+#define INFO2_SCLKDIVEN 0x2000
+#define INFO2_CBSY      0x4000
+#define INFO2_ERRS      0x807f
+
+#define ZE0_SDHI_VERSION 0x000d
+
+enum { XFER_NONE, XFER_READ, XFER_WRITE };
+
+static void ze0_sdhi_update_irq(Ze0SdhiState *s)
+{
+    bool level = (s->info1 & ~s->info1_mask & 0x001d) ||
+                 (s->info2 & ~s->info2_mask & (INFO2_ERRS | INFO2_BRE | INFO2_BWE));
+
+    qemu_set_irq(s->irq, level);
+}
+
+static void ze0_sdhi_card_status(Ze0SdhiState *s)
+{
+    s->info1 &= ~(INFO1_CD | INFO1_WP);
+    if (sdbus_get_inserted(&s->sdbus)) {
+        s->info1 |= INFO1_CD;
+        if (!sdbus_get_readonly(&s->sdbus)) {
+            s->info1 |= INFO1_WP;
+        }
+    }
+}
+
+static void ze0_sdhi_reset(DeviceState *dev)
+{
+    Ze0SdhiState *s = ZE0_SDHI(dev);
+
+    memset(s->rsp, 0, sizeof(s->rsp));
+    s->cmd = s->arg = s->stop = 0;
+    s->seccnt = 0;
+    s->info1 = 0;
+    s->info2 = INFO2_DAT0 | INFO2_SCLKDIVEN;
+    s->info1_mask = 0x031d;
+    s->info2_mask = 0x8b7f;
+    s->clk_ctrl = 0x0020;
+    s->size = 0x0200;
+    s->option = 0x40ee;
+    s->sdio_mode = s->sdio_info1 = 0;
+    s->sdio_info1_mask = 0xc007;
+    s->cc_ext_mode = 0;
+    s->host_mode = 0;
+    s->xfer = XFER_NONE;
+    s->blk_left = s->blocks_left = 0;
+    ze0_sdhi_card_status(s);
+    ze0_sdhi_update_irq(s);
+}
+
+static void ze0_sdhi_end_access(Ze0SdhiState *s)
+{
+    s->xfer = XFER_NONE;
+    s->info2 &= ~(INFO2_BRE | INFO2_BWE);
+    s->info1 |= INFO1_ACCEND;
+    if (s->stop & 0x0100) {
+        /* SD_STOP.SEC: automatic CMD12 after a multi-block transfer */
+        SDRequest req = { .cmd = 12, .arg = 0 };
+        uint8_t r[16];
+
+        if (s->cmd_index == 18 || s->cmd_index == 25) {
+            sdbus_do_command(&s->sdbus, &req, r, sizeof(r));
+        }
+    }
+}
+
+static void ze0_sdhi_next_block(Ze0SdhiState *s)
+{
+    if (s->blocks_left == 0) {
+        ze0_sdhi_end_access(s);
+        return;
+    }
+    s->blocks_left--;
+    s->blk_left = s->size ? s->size : 0x200;
+    if (s->xfer == XFER_READ) {
+        s->info2 |= INFO2_BRE;
+    } else {
+        s->info2 |= INFO2_BWE;
+    }
+}
+
+static void ze0_sdhi_send(Ze0SdhiState *s, uint16_t cmd)
+{
+    SDRequest req;
+    uint8_t r[16];
+    int len, i;
+    bool multi;
+
+    s->cmd = cmd;
+    s->cmd_index = cmd & 0x3f;
+    req.cmd = cmd & 0x3f;
+    req.arg = s->arg;
+    req.crc = 0;
+    if ((cmd & 0x0040) && !s->app_cmd && req.cmd != 55) {
+        /* ACMD bit without a preceding CMD55: send it, RCA from CMD3 */
+        SDRequest app = { .cmd = 55, .arg = (uint32_t)s->rca << 16 };
+
+        sdbus_do_command(&s->sdbus, &app, r, sizeof(r));
+    }
+    s->info2 &= ~INFO2_ERRS;
+    len = sdbus_do_command(&s->sdbus, &req, r, sizeof(r));
+    s->app_cmd = (req.cmd == 55 && len > 0);
+    memset(s->rsp, 0, sizeof(s->rsp));
+    if (len == 4) {
+        uint32_t v = ldl_be_p(r);
+
+        s->rsp[0] = v & 0xffff;
+        s->rsp[1] = v >> 16;
+        if (req.cmd == 3) {
+            s->rca = v >> 16;
+        }
+    } else if (len == 16) {
+        /* R2: bits 127..8 of the response (CRC byte dropped), LSW first */
+        for (i = 0; i < 15; i++) {
+            int bit = (14 - i) * 8;     /* r[14] -> bits 7..0 */
+            s->rsp[bit / 16] |= r[i] << (bit % 16);
+        }
+    } else if (req.cmd != 0) {
+        s->info2 |= INFO2_RSPTO;
+        qemu_log_mask(LOG_UNIMP, "ze0-sdhi%d: CMD%d arg 0x%08x: no response\n",
+                      s->port, req.cmd, req.arg);
+        ze0_sdhi_update_irq(s);
+        return;
+    }
+    s->info1 |= INFO1_RSPEND;
+    multi = (req.cmd == 18 || req.cmd == 25);
+    if (sdbus_data_ready(&s->sdbus)) {
+        s->xfer = XFER_READ;
+        s->blocks_left = multi ? (s->seccnt ? s->seccnt : 1) : 1;
+        ze0_sdhi_next_block(s);
+    } else if (sdbus_receive_ready(&s->sdbus)) {
+        s->xfer = XFER_WRITE;
+        s->blocks_left = multi ? (s->seccnt ? s->seccnt : 1) : 1;
+        ze0_sdhi_next_block(s);
+    }
+    ze0_sdhi_update_irq(s);
+}
+
+static uint64_t ze0_sdhi_read_buf(Ze0SdhiState *s, unsigned size)
+{
+    uint64_t v = 0;
+    unsigned i;
+
+    if (s->xfer != XFER_READ || !(s->info2 & INFO2_BRE)) {
+        return 0;
+    }
+    for (i = 0; i < size && s->blk_left; i++, s->blk_left--) {
+        v |= (uint64_t)sdbus_read_byte(&s->sdbus) << (8 * i);
+    }
+    if (s->blk_left == 0) {
+        s->info2 &= ~INFO2_BRE;
+        ze0_sdhi_next_block(s);
+        ze0_sdhi_update_irq(s);
+    }
+    return v;
+}
+
+static void ze0_sdhi_write_buf(Ze0SdhiState *s, uint64_t v, unsigned size)
+{
+    unsigned i;
+
+    if (s->xfer != XFER_WRITE || !(s->info2 & INFO2_BWE)) {
+        return;
+    }
+    for (i = 0; i < size && s->blk_left; i++, s->blk_left--) {
+        sdbus_write_byte(&s->sdbus, v >> (8 * i));
+    }
+    if (s->blk_left == 0) {
+        s->info2 &= ~INFO2_BWE;
+        ze0_sdhi_next_block(s);
+        ze0_sdhi_update_irq(s);
+    }
+}
+
+static uint64_t ze0_sdhi_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Ze0SdhiState *s = opaque;
+    uint64_t v;
+
+    switch (addr) {
+    case SD_CMD:        v = s->cmd; break;
+    case SD_ARG0:       v = size == 4 ? s->arg : (s->arg & 0xffff); break;
+    case SD_ARG1:       v = s->arg >> 16; break;
+    case SD_STOP:       v = s->stop; break;
+    case SD_SECCNT:     v = s->seccnt; break;
+    case SD_RSP0 ... SD_RSP0 + 0x0f:
+        v = s->rsp[(addr - SD_RSP0) / 2];
+        if (size == 4 && (addr - SD_RSP0) / 2 + 1 < 8) {
+            v |= (uint32_t)s->rsp[(addr - SD_RSP0) / 2 + 1] << 16;
+        }
+        break;
+    case SD_INFO1:
+        ze0_sdhi_card_status(s);
+        v = s->info1;
+        if (size == 4) {
+            v |= (uint32_t)s->info2 << 16;
+        }
+        break;
+    case SD_INFO2:      v = s->info2; break;
+    case SD_INFO1_MASK: v = s->info1_mask; break;
+    case SD_INFO2_MASK: v = s->info2_mask; break;
+    case SD_CLK_CTRL:   v = s->clk_ctrl; break;
+    case SD_SIZE:       v = s->size; break;
+    case SD_OPTION:     v = s->option; break;
+    case SD_ERR_STS1:
+    case SD_ERR_STS2:   v = 0; break;
+    case SD_BUF0:       return ze0_sdhi_read_buf(s, size);
+    case SDIO_MODE:     v = s->sdio_mode; break;
+    case SDIO_INFO1:    v = s->sdio_info1; break;
+    case SDIO_INFO1_MASK: v = s->sdio_info1_mask; break;
+    case CC_EXT_MODE:   v = s->cc_ext_mode; break;
+    case SOFT_RST:      v = 0x0007; break;
+    case SD_VERSION:    v = ZE0_SDHI_VERSION; break;
+    case HOST_MODE:     v = s->host_mode; break;
+    default:
+        v = 0;
+        qemu_log_mask(LOG_UNIMP, "ze0-sdhi%d: read of unknown +0x%02x\n",
+                      s->port, (unsigned)addr);
+        break;
+    }
+    if (s->trace) {
+        qemu_log_mask(LOG_UNIMP, "ze0-sdhi%d: rd%u +0x%02x = 0x%04" PRIx64 "\n",
+                      s->port, size * 8, (unsigned)addr, v);
+    }
+    return v;
+}
+
+static void ze0_sdhi_write(void *opaque, hwaddr addr, uint64_t v, unsigned size)
+{
+    Ze0SdhiState *s = opaque;
+
+    if (s->trace && addr != SD_BUF0) {
+        qemu_log_mask(LOG_UNIMP, "ze0-sdhi%d: wr%u +0x%02x = 0x%04" PRIx64 "\n",
+                      s->port, size * 8, (unsigned)addr, v);
+    }
+    switch (addr) {
+    case SD_CMD:        ze0_sdhi_send(s, v); return;
+    case SD_ARG0:
+        if (size == 4) {
+            s->arg = v;
+        } else {
+            s->arg = (s->arg & 0xffff0000) | (v & 0xffff);
+        }
+        break;
+    case SD_ARG1:       s->arg = (s->arg & 0xffff) | (v & 0xffff) << 16; break;
+    case SD_STOP:
+        s->stop = v & 0x0100;
+        if (v & 1) {
+            SDRequest req = { .cmd = 12, .arg = 0 };
+            uint8_t r[16];
+
+            sdbus_do_command(&s->sdbus, &req, r, sizeof(r));
+            s->xfer = XFER_NONE;
+            s->info2 &= ~(INFO2_BRE | INFO2_BWE);
+            s->info1 |= INFO1_ACCEND;
+        }
+        break;
+    case SD_SECCNT:     s->seccnt = v; break;
+    case SD_INFO1:
+        s->info1 &= v | INFO1_CD | INFO1_WP;
+        if (size == 4) {
+            s->info2 &= (v >> 16) | ~(INFO2_ERRS | INFO2_BRE | INFO2_BWE);
+        }
+        break;
+    case SD_INFO2:      s->info2 &= v | ~(INFO2_ERRS | INFO2_BRE | INFO2_BWE); break;
+    case SD_INFO1_MASK: s->info1_mask = v; break;
+    case SD_INFO2_MASK: s->info2_mask = v; break;
+    case SD_CLK_CTRL:   s->clk_ctrl = v; break;
+    case SD_SIZE:       s->size = v & 0x3ff; break;
+    case SD_OPTION:     s->option = v; break;
+    case SD_BUF0:       ze0_sdhi_write_buf(s, v, size); return;
+    case SDIO_MODE:     s->sdio_mode = v; break;
+    case SDIO_INFO1:    s->sdio_info1 &= v; break;
+    case SDIO_INFO1_MASK: s->sdio_info1_mask = v; break;
+    case CC_EXT_MODE:
+        s->cc_ext_mode = v;
+        if (v & 2) {
+            qemu_log_mask(LOG_UNIMP, "ze0-sdhi%d: DMA mode requested "
+                          "(CC_EXT_MODE 0x%04x), not modelled\n",
+                          s->port, (unsigned)v);
+        }
+        break;
+    case SOFT_RST:
+        if (!(v & 1)) {
+            s->xfer = XFER_NONE;
+            s->info2 &= ~(INFO2_BRE | INFO2_BWE | INFO2_ERRS);
+        }
+        break;
+    case HOST_MODE:     s->host_mode = v; break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "ze0-sdhi%d: write of unknown +0x%02x = 0x%"
+                      PRIx64 "\n", s->port, (unsigned)addr, v);
+        break;
+    }
+    ze0_sdhi_update_irq(s);
+}
+
+static const MemoryRegionOps ze0_sdhi_ops = {
+    .read = ze0_sdhi_read,
+    .write = ze0_sdhi_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4 },
+    .impl = { .min_access_size = 1, .max_access_size = 4 },
+};
+
+static void ze0_sdhi_init(Object *obj)
+{
+    Ze0SdhiState *s = ZE0_SDHI(obj);
+
+    qbus_init(&s->sdbus, sizeof(s->sdbus), TYPE_SD_BUS, DEVICE(obj), "sd-bus");
+    memory_region_init_io(&s->iomem, obj, &ze0_sdhi_ops, s, "ze0-sdhi", 0x100);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+
+static const Property ze0_sdhi_props[] = {
+    DEFINE_PROP_UINT8("port", Ze0SdhiState, port, 0),
+    DEFINE_PROP_BOOL("trace", Ze0SdhiState, trace, false),
+};
+
+static void ze0_sdhi_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    device_class_set_legacy_reset(dc, ze0_sdhi_reset);
+    device_class_set_props(dc, ze0_sdhi_props);
+}
+
+static const TypeInfo ze0_sdhi_types[] = {
+    {
+        .name = TYPE_ZE0_SDHI,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(Ze0SdhiState),
+        .instance_init = ze0_sdhi_init,
+        .class_init = ze0_sdhi_class_init,
+    },
+};
+
+DEFINE_TYPES(ze0_sdhi_types)
