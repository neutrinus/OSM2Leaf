sh4: odd-PC instruction fetch raises an address error; ze0: extension DRAM (TODO M8.B5).

target/sh4: an instruction fetch from an odd address is an instruction
address error on SH-4 (EXPEVT 0x0e0, SPC = TEA = the address).  QEMU
fetched the halfword anyway and usually raised an illegal instruction
(0x180).  Windows CE uses this exception for its API traps: callers jump
to odd addresses 0xfffffe01 - 2 * n, and the EU2011 nk.exe general
exception handler (VBR+0x100 = 0x8800ed10) compares EXPEVT with 0x0e0
and SPC with 0xffff7e03 before dispatching.  With 0x180 the kernel reported
"Exception 180 ... PC=fffffd51 ... Unhandled exception c000001d" and halted.
New helper raise_iaddr_error; system emulation only.

hw/sh4/ze0.c: 128 MiB RAM at phys 0x10000000 (P1 0x90000000, P2
0xb0000000) instead of the area-4 catch-all.  The EU2011 OAL memory
table (ROM 0x88599c98) lists {0x90000000, 0x08000000} and the kernel
prints "Memory Sections: [1] : start: 90000000 ... length: 07ff8000";
without it the kernel logs "GrabFirstPhysPage : invalid address
0x00000000".  ext-ram=off keeps the old catch-all (negative control).

Evidence and controls: docs/experiments/EXP-2026-11-20-M8.B5-ze0-f1-filesys.md
(C-1350..C-1354).  Base: QEMU 8.2.10 + the earlier patches (sorts after
ze0-0005).

diff --git a/hw/sh4/ze0.c b/hw/sh4/ze0.c
index c04f13c..a450d7c 100644
--- a/hw/sh4/ze0.c
+++ b/hw/sh4/ze0.c
@@ -51,6 +51,17 @@
 #define ZE0_AREA4_BASE     0x10000000u
 #define ZE0_AREA4_SIZE     0x04000000u
 
+/*
+ * Extension DRAM (M8.B5): the EU2011 OAL's memory table (nk.exe .data at
+ * ROM 0x88599c98, RAM 0x89e43c98) lists {0x90000000, 0x08000000} after
+ * the main DRAM, and the kernel prints it as "Memory Sections: [1] start
+ * 90000000 ... length 07ff8000".  So phys 0x10000000 is a second 128 MiB
+ * of RAM, not an area-4 device.  ext-ram=off keeps the old catch-all
+ * (negative control).
+ */
+#define ZE0_EXT_RAM_BASE   0x10000000u
+#define ZE0_EXT_RAM_SIZE   (128 * MiB)
+
 #define ZE0_AREA6_BASE     0x18000000u
 #define ZE0_AREA6_SIZE     0x04000000u
 
@@ -104,6 +115,7 @@ struct Ze0MachineState {
     uint64_t kernel_off;
     uint64_t app_off;
     bool tmu;
+    bool ext_ram;
 };
 
 #define ZE0_DEFAULT_KERNEL_OFF 0x3e00200u
@@ -294,7 +306,26 @@ static void ze0_init(MachineState *machine)
      * so neither is shadowed.
      */
     create_unimplemented_device("ze0-p4", ZE0_P4_CATCH_BASE, ZE0_P4_CATCH_SIZE);
-    create_unimplemented_device("ze0-area4", ZE0_AREA4_BASE, ZE0_AREA4_SIZE);
+    if (ZE0_MACHINE(machine)->ext_ram) {
+        MemoryRegion *ext = g_new(MemoryRegion, 1);
+        MemoryRegion *ext_p1 = g_new(MemoryRegion, 1);
+        MemoryRegion *ext_p2 = g_new(MemoryRegion, 1);
+
+        memory_region_init_ram(ext, NULL, "ze0.ext-ram", ZE0_EXT_RAM_SIZE,
+                               &error_fatal);
+        memory_region_add_subregion(sysmem, ZE0_EXT_RAM_BASE, ext);
+        memory_region_init_alias(ext_p1, NULL, "ze0.ext-ram-p1", ext, 0,
+                                 ZE0_EXT_RAM_SIZE);
+        memory_region_add_subregion(sysmem, ZE0_EXT_RAM_BASE | 0x80000000u,
+                                    ext_p1);
+        memory_region_init_alias(ext_p2, NULL, "ze0.ext-ram-p2", ext, 0,
+                                 ZE0_EXT_RAM_SIZE);
+        memory_region_add_subregion(sysmem, ZE0_EXT_RAM_BASE | 0xa0000000u,
+                                    ext_p2);
+    } else {
+        create_unimplemented_device("ze0-area4", ZE0_AREA4_BASE,
+                                    ZE0_AREA4_SIZE);
+    }
     create_unimplemented_device("ze0-area6", ZE0_AREA6_BASE, ZE0_AREA6_SIZE);
 
     /* SH-4 CCN/MMU/exception registers and cache/TLB arrays. */
@@ -349,6 +380,16 @@ static void ze0_set_tmu(Object *obj, bool value, Error **errp)
     ZE0_MACHINE(obj)->tmu = value;
 }
 
+static bool ze0_get_ext_ram(Object *obj, Error **errp)
+{
+    return ZE0_MACHINE(obj)->ext_ram;
+}
+
+static void ze0_set_ext_ram(Object *obj, bool value, Error **errp)
+{
+    ZE0_MACHINE(obj)->ext_ram = value;
+}
+
 static void ze0_machine_instance_init(Object *obj)
 {
     Ze0MachineState *s = ZE0_MACHINE(obj);
@@ -356,6 +397,11 @@ static void ze0_machine_instance_init(Object *obj)
     s->kernel_off = ZE0_DEFAULT_KERNEL_OFF;
     s->app_off = ZE0_DEFAULT_APP_OFF;
     s->tmu = true;
+    s->ext_ram = true;
+    object_property_add_bool(obj, "ext-ram", ze0_get_ext_ram, ze0_set_ext_ram);
+    object_property_set_description(obj, "ext-ram",
+        "128 MiB extension DRAM at phys 0x10000000 (default on; off = the "
+        "old area-4 catch-all, negative control)");
     object_property_add_bool(obj, "tmu", ze0_get_tmu, ze0_set_tmu);
     object_property_set_description(obj, "tmu",
         "map TMU ch0-2 at 0xffd80000 (default on; off = negative control)");
diff --git a/target/sh4/helper.h b/target/sh4/helper.h
index 29011d3..77b6d87 100644
--- a/target/sh4/helper.h
+++ b/target/sh4/helper.h
@@ -1,5 +1,6 @@
 DEF_HELPER_1(ldtlb, void, env)
 DEF_HELPER_1(raise_illegal_instruction, noreturn, env)
+DEF_HELPER_1(raise_iaddr_error, noreturn, env)
 DEF_HELPER_1(raise_slot_illegal_instruction, noreturn, env)
 DEF_HELPER_1(raise_fpu_disable, noreturn, env)
 DEF_HELPER_1(raise_slot_fpu_disable, noreturn, env)
diff --git a/target/sh4/op_helper.c b/target/sh4/op_helper.c
index 8b7f378..44905ac 100644
--- a/target/sh4/op_helper.c
+++ b/target/sh4/op_helper.c
@@ -72,6 +72,12 @@ void helper_raise_illegal_instruction(CPUSH4State *env)
     raise_exception(env, 0x180, 0);
 }
 
+void helper_raise_iaddr_error(CPUSH4State *env)
+{
+    env->tea = env->pc;
+    raise_exception(env, 0x0e0, 0);
+}
+
 void helper_raise_slot_illegal_instruction(CPUSH4State *env)
 {
     raise_exception(env, 0x1a0, 0);
diff --git a/target/sh4/translate.c b/target/sh4/translate.c
index 5c0a4cc..426c87b 100644
--- a/target/sh4/translate.c
+++ b/target/sh4/translate.c
@@ -2272,6 +2272,21 @@ static void sh4_tr_translate_insn(DisasContextBase *dcbase, CPUState *cs)
     }
 #endif
 
+#ifndef CONFIG_USER_ONLY
+    if (unlikely(ctx->base.pc_next & 1)) {
+        /*
+         * SH-4: fetching an instruction from an odd address is an
+         * instruction address error (EXPEVT 0x0e0, SPC = TEA = the address).
+         * Windows CE uses it for its API traps: callers jump to odd
+         * addresses at 0xfffffe01 - 2 * n.
+         */
+        gen_save_cpu_state(ctx, true);
+        gen_helper_raise_iaddr_error(tcg_env);
+        ctx->base.is_jmp = DISAS_NORETURN;
+        ctx->base.pc_next += 1;
+        return;
+    }
+#endif
     ctx->opcode = translator_lduw(env, &ctx->base, ctx->base.pc_next);
     decode_opc(ctx);
     ctx->base.pc_next += 2;
