@@ -81,7 +85,7 @@ static bool is_op(uint32_t w)
     switch (w >> 24) {
     case 0x08:
         return w == 0x08000000;
-    case 0x12: case 0x18: case 0x28: case 0x30: case 0x38: case 0x40:
+    case 0x12: case 0x18: case 0x28: case 0x30: case 0x38: case 0x40: case 0x44:
     case 0x80: case 0x82: case 0xa0: case 0xa8: case 0xd0: case 0xe0:
     case 0xb0: case 0xb1: case 0xb2: case 0xb3:
     case 0xb4: case 0xb5: case 0xb6: case 0xb7:
@@ -390,6 +394,12 @@ void ze0_2dg_run(Ze0GfxState *s, uint32_t list)
             d->ly = (int16_t)w1;
             pc += 8;
             continue;
+        case 0x44:
+            /* AuiApp: 44000000 000001e0 ... 44000000 0000fe20 (page 2) */
