+/*
+ * Display surface (TODO M8.H4).  The unit has no scanout registers we can
+ * hand to QEMU as memory: gdisubdrv.dll composes up to four DU planes in
+ * VRAM and the hardware scans them out with per-plane colour key/opacity.
+ * This reimplements tools/ze0_screenshot.py compose(): planes with a higher
+ * number are drawn first, plane 1 last; a plane in keyed mode (mode bits
+ * 0xf000 == 0x1000) drops pixels with bit 15 clear or the colour key.  The
+ * result is 800x480 x8r8g8b8, the format qemu_create_displaysurface() uses.
+ */
+static uint32_t ze0_plane_reg(Ze0GfxState *s, int n, hwaddr off)
+{
+    return ze0_reg(s, 0, 0x100 * n + off);
+}
+
+static bool ze0_band_visible(uint64_t base, uint32_t stride, uint32_t w,
+                             uint32_t h, bool keyed, uint32_t key)
+{
+    uint8_t row[ZE0_DU_W * 2];
+    uint32_t x, y;
+
+    if (!keyed) {
+        return true;
+    }
+    for (y = 0; y < h; y++) {
+        if (address_space_read(&address_space_memory,
+                               base + (uint64_t)y * stride * 2,
+                               MEMTXATTRS_UNSPECIFIED, row, w * 2) != MEMTX_OK) {
+            continue;
+        }
+        for (x = 0; x < w; x++) {
+            uint32_t px = lduw_le_p(row + x * 2);
+
+            if ((px & 0x8000) && (px & 0x7fff) != key) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void ze0_gfx_compose(Ze0GfxState *s)
+{
+    static const uint32_t page_rows[2] = { 0, 960 };
+    int order[4] = { 4, 3, 2, 1 };
+    int i, j, x, y, r;
+
+    if (!s->fb) {
+        return;
+    }
+    memset(s->fb, 0, ZE0_DU_W * ZE0_DU_H * sizeof(uint32_t));
+    for (i = 0; i < 4; i++) {
+        int n = order[i];
+        uint32_t mode = ze0_plane_reg(s, n, 0x00);
+        uint32_t stride = ze0_plane_reg(s, n, 0x04);
+        uint32_t pw = ze0_plane_reg(s, n, 0x10);
+        uint32_t ph = ze0_plane_reg(s, n, 0x14);
+        uint32_t addr = ze0_plane_reg(s, n, 0x20);
+        uint32_t sx = ze0_plane_reg(s, n, 0x30);
+        uint32_t sy = ze0_plane_reg(s, n, 0x34);
+        uint32_t key = ze0_plane_reg(s, n, 0x48) & 0x7fff;
+        bool keyed = (mode & 0xf000) == 0x1000;
+        uint64_t base, addrs;
+        uint32_t w, h;
+
+        if (!(pw && ph && addr && stride)) {
+            continue;
+        }
+        w = MIN(pw, ZE0_DU_W);
+        h = MIN(ph, ZE0_DU_H);
+        addrs = addr & 0x1fffffffu;
+        base = addrs + ((uint64_t)sy * stride + sx) * 2;
+        /*
+         * A keyed plane whose window band holds no visible pixel but whose
+         * other 480-row page does: the NK1 AUI draws into one page while
+         * +0x34 stays on the other (M8.C1t), so show the page with content.
+         */
+        if (!ze0_band_visible(base, stride, w, h, keyed, key)) {
+            for (j = 0; j < 2; j++) {
+                uint64_t page;
+
+                if (page_rows[j] == sy) {
+                    continue;
+                }
+                page = addrs +
+                       ((uint64_t)page_rows[j] * stride + sx) * 2;
+                if (ze0_band_visible(page, stride, w, h, keyed, key)) {
+                    base = page;
+                    break;
+                }
+            }
+        }
+        for (y = 0; y < h; y++) {
+            uint8_t row[ZE0_DU_W * 2];
+
+            r = address_space_read(&address_space_memory,
+                                   base + (uint64_t)y * stride * 2,
+                                   MEMTXATTRS_UNSPECIFIED, row, w * 2);
+            if (r != MEMTX_OK) {
+                continue;
+            }
+            for (x = 0; x < w; x++) {
+                uint32_t px = lduw_le_p(row + x * 2);
+
+                if (keyed && (!(px & 0x8000) || (px & 0x7fff) == key)) {
+                    continue;
+                }
+                s->fb[y * ZE0_DU_W + x] =
+                    rgb_to_pixel32((px >> 10 & 0x1f) << 3,
+                                   (px >> 5 & 0x1f) << 3,
+                                   (px & 0x1f) << 3);
+            }
+        }
+    }
+}
+
+
+static bool ze0_gfx_display_update(void *opaque)
+{
+    Ze0GfxState *s = opaque;
+    DisplaySurface *surface;
+    uint8_t *data;
+    int stride, y;
+
+    if (!s->con) {
+        return true;
+    }
+    ze0_gfx_compose(s);
+    /* The console surface is an allocated x8r8g8b8 image; the composed
+     * pixels are copied into it (same bytes rgb_to_pixel32 produced). */
+    surface = qemu_console_surface(s->con);
+    data = surface_data(surface);
+    stride = surface_stride(surface);
+    for (y = 0; y < ZE0_DU_H; y++) {
+        memcpy(data + (size_t)y * stride,
+               s->fb + (size_t)y * ZE0_DU_W,
+               ZE0_DU_W * sizeof(uint32_t));
+    }
+    qemu_console_update(s->con, 0, 0, ZE0_DU_W, ZE0_DU_H);
+    return true;
+}
+
+static void ze0_gfx_display_invalidate(void *opaque)
+{
+    Ze0GfxState *s = opaque;
+
+    if (s->con) {
+        ze0_gfx_display_update(s);
+    }
+}
+
+static const GraphicHwOps ze0_gfx_display_ops = {
+    .invalidate = ze0_gfx_display_invalidate,
+    .gfx_update = ze0_gfx_display_update,
+};
