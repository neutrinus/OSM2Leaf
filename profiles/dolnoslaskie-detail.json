{
  "name": "dolnoslaskie-detail",
  "description": "Full detail for Dolnośląskie with a border buffer for cross-border routing. Experimental sub-tile clipping.",
  "sources": ["poland-latest.osm.pbf"],
  "include": {
    "countries": ["PL"],
    "bbox": [14.0, 49.9, 17.9, 51.9],
    "border_buffer_km": 50,
    "tiles": {"mode": "auto", "include": [], "exclude": []}
  },
  "detail": {
    "roads": "all",
    "addresses": true,
    "pois": "all",
    "admin_boundaries": true
  },
  "routing": {
    "profile": "car",
    "keep_cross_border": true
  }
}
